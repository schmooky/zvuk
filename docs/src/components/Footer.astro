---
import { SITE } from '../lib/seo';

/** Four-column footer in the pixi-reels shape: the name and a line, then three link columns. */
const cols = [
  {
    title: 'Docs',
    items: [
      { href: '/docs/quickstart/', label: 'Quickstart' },
      { href: '/concepts/', label: 'Concepts' },
      { href: '/fx/', label: 'FX' },
      { href: '/guides/', label: 'Guides' },
      { href: '/recipes/', label: 'Recipes' },
    ],
  },
  {
    title: 'Reference',
    items: [
      { href: '/api/', label: 'API' },
      { href: '/reference/cli/', label: 'CLI' },
      { href: '/guides/errors/', label: 'Errors' },
      { href: '/changelog/', label: 'Changelog' },
      { href: '/llms.txt', label: 'llms.txt' },
    ],
  },
  {
    title: 'Project',
    items: [
      { href: '/roadmap/', label: 'Roadmap' },
      { href: '/examples/', label: 'Examples' },
      { href: SITE.github, label: 'GitHub', external: true },
      { href: SITE.npm, label: 'npm', external: true },
    ],
  },
];
---
<footer class="mt-20 border-t border-border">
  <div class="container py-12">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <div class="text-lg font-bold tracking-tight">{SITE.name}</div>
        <p class="mt-3 max-w-xs text-sm text-muted-foreground">
          An audio engine for the web: buses, ducking, snapshots and a codec ladder, on Web Audio.
        </p>
        <p class="mt-3 font-mono text-[11px] text-brand-text">{SITE.npmName}@{SITE.version}</p>
      </div>
      {cols.map((col) => (
        <div class="flex flex-col gap-2">
          <div class="mb-1 font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-muted-foreground">{col.title}</div>
          {col.items.map((item) => (
            <a
              href={item.href}
              class="text-sm text-muted-foreground transition-colors hover:text-foreground"
              {...('external' in item && item.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {item.label}
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-col justify-between gap-2 border-t border-border pt-6 text-xs text-muted-foreground md:flex-row">
      <span>
        MIT licensed. Demo SFX from{' '}
        <a href="https://kenney.nl/assets/digital-audio" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-foreground">Kenney's Digital Audio pack</a>
        {' '}(CC0).
      </span>
      <span>Built with Astro, React and shadcn/ui on the Web Audio API.</span>
    </div>
  </div>
</footer>
