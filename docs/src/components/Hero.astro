---
import { Code } from 'astro:components';
import { SITE } from '../lib/seo';
import CopyCommand from './CopyCommand.astro';

/*
  The landing hero in the pixi-reels shape, but following the theme (light in
  light mode, dark in dark mode) rather than ink in both: an eyebrow with the version, a two-line display headline
  whose second line carries the one hue, a lead, two actions and the install
  pill. The right column is the marrow move: the code that makes the sound,
  rather than a picture of it.
*/
// Lines stay under ~54 columns so the panel never scrolls sideways.
const sample = `import { createEngine } from '@schmooky/zvuk';

const engine = createEngine({
  buses: { music: {}, sfx: {}, voice: {} },
});

button.onclick = async () => {
  await engine.unlock(); // the gesture iOS wants

  await engine.loadSound('coin', [
    '/sfx/coin.webm',
    '/sfx/coin.m4a', // Safari fallback
  ], { bus: 'sfx', limit: { max: 3 } });

  // The music dips while the coin rings.
  engine.sound('coin').play({
    duck: { bus: 'music', amount: 0.4 },
  });
};`;
---
<section class="relative overflow-hidden border-b border-border">
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="container relative grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14 lg:py-24">
    <div class="flex min-w-0 flex-col items-start">
      <p class="eyebrow">Web Audio engine for games</p>

      <h1 class="display-1 mt-5">
        <span class="block">Audio engine</span>
        <span class="block text-primary">for the web.</span>
      </h1>

      <p class="mt-7 max-w-[34rem] text-pretty text-lg leading-relaxed text-muted-foreground sm:text-xl">
        Buses, FX, ducking, snapshots and music on a beat grid, with a codec
        ladder that survives Safari. Typed, ESM-only, no dependencies.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/docs/quickstart/"
          class="inline-flex h-12 items-center rounded-md bg-primary px-6 text-[15px] font-semibold text-primary-foreground transition-[transform,filter] duration-150 hover:brightness-110 active:scale-[0.98]"
        >
          Get started
        </a>
        <a
          href="/recipes/"
          class="inline-flex h-12 items-center rounded-md border border-border px-6 text-[15px] font-semibold text-foreground transition-colors duration-150 hover:border-foreground/60 hover:bg-secondary/60"
        >
          See the recipes
        </a>
      </div>

      <div class="mt-6 max-w-full">
        <CopyCommand command={`pnpm add ${SITE.npmName}`} />
      </div>
    </div>

    <div class="min-w-0 overflow-hidden rounded-lg border border-code-border bg-code-bg shadow-[0_30px_80px_-30px_rgb(0_0_0/0.25)] dark:shadow-[0_30px_80px_-30px_rgb(0_0_0/0.8)]">
      <div class="flex items-center justify-between border-b border-code-border px-4 py-2 font-mono text-[10.5px] uppercase tracking-[0.14em] text-code-muted">
        <span>main.ts</span>
        <span>ts</span>
      </div>
      <div class="overflow-x-auto text-[12.5px] leading-[1.75] sm:text-[13px] [&_pre]:!m-0 [&_pre]:!bg-transparent [&_pre]:px-5 [&_pre]:py-4">
        <Code code={sample} lang="ts" themes={{ light: 'github-light', dark: 'github-dark' }} />
      </div>
    </div>
  </div>
</section>
