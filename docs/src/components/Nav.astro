---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import MobileNav from './MobileNav';
import AudioBar from './AudioBar';
import ThemeToggle from './ThemeToggle';
import { TOP_NAV, TOP_NAV_UTILITY } from '../content/nav';
import { SITE } from '../lib/seo';
import Search from './Search.astro';
const pathname = Astro.url.pathname;
function isActive(item: { href: string; match?: string[] }): boolean {
  return (item.match ?? [item.href]).some((p) => pathname.startsWith(p));
}
const mobileLinks = [
  ...TOP_NAV,
  ...TOP_NAV_UTILITY,
  { href: SITE.github, label: 'GitHub' },
  { href: SITE.npm, label: 'npm' },
];
---
<header class="sticky top-0 z-50 w-full border-b border-border glass">
  <div class="container flex h-14 items-center">
    <div class="mr-5 flex shrink-0 items-center gap-2">
      <a href="/" class="flex items-center gap-2 text-[15px] font-bold tracking-tight">
        {/* The favicon's three bars on a zinc plate, as marrow does with its mark. */}
        <svg class="size-6 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#18181b" />
          <g fill="#8a7bff">
            <rect x="14" y="21" width="8" height="22" rx="4" />
            <rect x="28" y="12" width="8" height="40" rx="4" />
            <rect x="42" y="17" width="8" height="30" rx="4" />
          </g>
        </svg>
        <span>{SITE.name}</span>
      </a>
      <a
        href="/changelog/"
        title={`${SITE.npmName} v${SITE.version}: changelog`}
        class="hidden rounded-sm border border-border px-1.5 py-px font-mono text-[10.5px] text-brand-text transition-colors hover:border-foreground/50 sm:inline-block"
      >
        v{SITE.version}
      </a>
    </div>

    <nav aria-label="Main" class="hidden h-14 items-stretch text-sm md:flex">
      {TOP_NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item) ? 'page' : undefined}
          class:list={[
            'relative inline-flex items-center px-3 text-muted-foreground transition-colors hover:text-foreground',
            { 'text-foreground after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:rounded-full after:bg-primary': isActive(item) },
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <Search />
      <div class="hidden md:flex items-center">
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          title="GitHub"
          class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'text-muted-foreground')}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden>
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 015.78 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.77 1.06.77 2.13 0 1.54-.01 2.78-.01 3.15 0 .3.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
        </a>
      </div>
      {/* Appears only once a demo has built the shared engine, so the nav
          never constructs an AudioContext of its own. */}
      <AudioBar client:idle />
      <ThemeToggle client:load />
      <MobileNav links={mobileLinks} pathname={pathname} client:load />
    </div>
  </div>
</header>
