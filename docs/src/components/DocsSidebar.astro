---
import type { NavSection } from '../content/nav';

/**
 * The section list, in the shape both sibling sites use: a mono eyebrow per
 * section and a hairline down the left whose accent segment marks the open
 * page. Rendered twice by the docs layout: in the sticky side column from md
 * up, and inside a <details> under the page title on phones.
 */
interface Props {
  nav: NavSection[];
  pathname: string;
  /** Distinguishes the two instances for the nav landmark label. */
  label?: string;
}
const { nav, pathname, label = 'Docs' } = Astro.props;
const here = pathname.endsWith('/') ? pathname : `${pathname}/`;
---
<nav aria-label={label} class="space-y-7 text-sm">
  {nav.map((section) => (
    <div>
      <div class="mb-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-muted-foreground">
        {section.title}
      </div>
      <ul class="border-l border-border">
        {section.items.map((item) => {
          const active = here === item.href;
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  '-ml-px flex items-center gap-2 border-l-2 py-1.5 pl-3.5 leading-snug transition-colors',
                  active
                    ? 'border-primary font-medium text-foreground'
                    : 'border-transparent text-muted-foreground hover:text-foreground',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
