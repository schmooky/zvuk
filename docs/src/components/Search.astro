---
/**
 * ⌘K search modal backed by Pagefind. The static index is built into
 * dist/pagefind/* by the docs build pipeline (`pagefind --site dist`),
 * which runs after Astro emits HTML.
 *
 * The modal lives at the top of the page tree and listens for ⌘K / Ctrl+K
 * everywhere; it fetches `/pagefind/pagefind.js` lazily on first open so the
 * 27-page docs site stays small for readers who never use search.
 */
---
<div id="search-root" class="hidden fixed inset-0 z-[100] flex items-start justify-center bg-background/80 px-4 pt-20 backdrop-blur-sm md:pt-24" role="dialog" aria-modal="true" aria-label="Search">
  <div class="w-full max-w-xl rounded-lg border border-border bg-card shadow-lg">
    <div class="flex items-center gap-2 border-b border-border px-4 py-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search docs…"
        class="w-full bg-transparent text-sm placeholder:text-muted-foreground focus:outline-none"
        autocomplete="off"
        aria-label="Search the docs"
      />
      <kbd class="ml-auto rounded border border-border bg-secondary/60 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">esc</kbd>
    </div>
    <ol id="search-results" class="max-h-[60vh] overflow-y-auto px-2 py-2 text-sm" aria-live="polite"></ol>
  </div>
</div>
{/* An icon on phones, a labelled pill from md up (the sibling sites' pill). */}
<button
  id="search-trigger"
  class="inline-flex size-9 items-center justify-center gap-2 rounded-md text-muted-foreground transition-colors hover:bg-secondary/60 hover:text-foreground md:h-8 md:w-auto md:border md:border-border md:px-3 md:text-sm"
  type="button"
  aria-label="Search the docs"
>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
  <span class="hidden md:inline">Search</span>
  <kbd class="ml-1 hidden rounded-sm border border-border bg-secondary/60 px-1.5 py-0.5 font-mono text-[10px] md:inline">⌘K</kbd>
</button>

<!--
  Inline + raw JS so Vite doesn't try to resolve /pagefind/pagefind.js at build
  time — that file is emitted by `pagefind --site dist` AFTER Astro finishes,
  so a normal ESM import would fail the build. The dynamic import sits inside
  a string template literal hidden from the bundler.
-->
<script is:inline>
  (() => {
    var pagefind = null;
    var root = document.getElementById('search-root');
    var input = document.getElementById('search-input');
    var results = document.getElementById('search-results');
    var trigger = document.getElementById('search-trigger');

    async function ensure() {
      if (pagefind) return pagefind;
      try {
        var url = '/pagefind/' + 'pagefind.js';
        pagefind = await import(/* @vite-ignore */ url);
        await pagefind.options({ baseUrl: '/' });
        return pagefind;
      } catch (e) {
        console.warn('Pagefind index not built. Run `pnpm build` in docs/ first.');
        if (results) {
          results.innerHTML = '<li class="px-3 py-2 text-xs text-muted-foreground">Search index unavailable in dev. Run a production build to enable search.</li>';
        }
        return null;
      }
    }

    function open() {
      if (!root) return;
      root.classList.remove('hidden');
      input && input.focus();
    }
    function close() {
      if (!root) return;
      root.classList.add('hidden');
    }

    trigger && trigger.addEventListener('click', function () {
      void ensure().then(open);
    });
    // The mobile menu (MobileNav.tsx) opens search through this event.
    window.addEventListener('zvuk:search', function () {
      void ensure().then(open);
    });

    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        void ensure().then(open);
      } else if (e.key === 'Escape') {
        close();
      }
    });

    root && root.addEventListener('click', function (e) {
      if (e.target === root) close();
    });

    var last = 0;
    input && input.addEventListener('input', async function () {
      var q = input.value.trim();
      var id = ++last;
      if (!q) {
        if (results) results.innerHTML = '';
        return;
      }
      var pf = await ensure();
      if (!pf || id !== last) return;
      var search = await pf.search(q);
      if (id !== last) return;
      var data = await rerank(search.results, 10, q);
      if (!results) return;
      if (!data.length) {
        results.innerHTML = '<li class="px-3 py-2 text-xs text-muted-foreground">No pages match.</li>';
        return;
      }
      results.innerHTML = data.map(renderHit).join('');
    });

    // Rerank from pixi-reels: the generated API pages are short and
    // repetitive, so Pagefind scores them above the page that explains the
    // thing. Scale by section, unless the query IS the symbol name.
    var SECTION_FACTOR = { API: 0.3, Changelog: 0.5 };
    async function rerank(all, n, q) {
      var pool = await Promise.all(all.slice(0, 40).map(function (r) {
        return r.data().then(function (d) { return { score: r.score, d: d }; });
      }));
      var exact = q.toLowerCase().replace(/\s+/g, '');
      pool.forEach(function (h) {
        var section = sectionOf(h.d.url);
        var title = String((h.d.meta && h.d.meta.title) || '').toLowerCase().split(' ')[0];
        var f = SECTION_FACTOR[section];
        if (f && !(section === 'API' && title === exact)) h.score *= f;
      });
      pool.sort(function (a, b) { return b.score - a.score; });
      return pool.slice(0, n).map(function (h) { return h.d; });
    }

    // Hit layout from pixi-reels: the section in the brand hue, the title,
    // and the heading inside the page when the hit is in a sub-section.
    function renderHit(d) {
      var title = (d.meta && d.meta.title) || d.url;
      title = String(title).replace(/ · zvuk$/, '');
      var section = sectionOf(d.url);
      var url = d.url;
      var heading = '';
      var excerpt = d.excerpt;
      var sub = (d.sub_results || []).filter(function (s) { return s.url.indexOf('#') >= 0; })[0];
      if (sub && sub.title !== title) {
        url = sub.url;
        heading = sub.title;
        excerpt = sub.excerpt || excerpt;
      }
      return (
        '<li class="border-b border-border/60 last:border-b-0 hover:bg-secondary/40"><a href="' + escapeHtml(url) + '" class="block px-3 py-2">' +
        '<div class="flex items-baseline gap-2">' +
        (section ? '<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-brand-text">' + escapeHtml(section) + '</span>' : '') +
        '<span class="truncate text-sm font-semibold">' + escapeHtml(title) + '</span>' +
        (heading ? '<span class="truncate text-xs text-muted-foreground">' + escapeHtml(heading) + '</span>' : '') +
        '</div>' +
        '<div class="mt-0.5 text-xs text-muted-foreground line-clamp-2">' + excerpt + '</div>' +
        '</a></li>'
      );
    }

    var SECTIONS = { docs: 'Docs', concepts: 'Concepts', fx: 'FX', guides: 'Guides', recipes: 'Recipes', examples: 'Examples', api: 'API', reference: 'Reference', changelog: 'Changelog' };
    function sectionOf(url) {
      var seg = String(url).replace(/^\/+/, '').split('/')[0];
      return SECTIONS[seg] || '';
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }
  })();
</script>
