---
/**
 * ⌘K search modal backed by Pagefind. The static index is built into
 * dist/pagefind/* by the docs build pipeline (`pagefind --site dist`),
 * which runs after Astro emits HTML.
 *
 * The modal lives at the top of the page tree and listens for ⌘K / Ctrl+K
 * everywhere; it fetches `/pagefind/pagefind.js` lazily on first open so the
 * 27-page docs site stays small for readers who never use search.
 */
---
<div id="search-root" class="hidden fixed inset-0 z-[100] flex items-start justify-center bg-background/80 backdrop-blur-sm pt-24">
  <div class="w-full max-w-xl rounded-xl border border-border bg-card shadow-lg">
    <div class="flex items-center gap-2 border-b border-border px-4 py-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search docs…"
        class="w-full bg-transparent text-sm placeholder:text-muted-foreground focus:outline-none"
        autocomplete="off"
      />
      <kbd class="ml-auto rounded border border-border bg-secondary/60 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">esc</kbd>
    </div>
    <ol id="search-results" class="max-h-[60vh] overflow-y-auto px-2 py-2 text-sm"></ol>
  </div>
</div>
<button
  id="search-trigger"
  class="hidden md:inline-flex h-8 items-center gap-2 rounded-md border border-border bg-transparent px-3 text-sm text-muted-foreground transition-colors hover:text-foreground hover:bg-secondary/50"
  type="button"
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
  Search
  <kbd class="ml-1 rounded border border-border bg-secondary/60 px-1.5 py-0.5 font-mono text-[10px]">⌘K</kbd>
</button>

<script>
  /* eslint-disable */
  let pagefind: any = null;
  const root = document.getElementById('search-root') as HTMLDivElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLOListElement;
  const trigger = document.getElementById('search-trigger') as HTMLButtonElement;

  async function ensure() {
    if (pagefind) return pagefind;
    try {
      // @vite-ignore
      pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      await pagefind.options({ baseUrl: '/' });
      return pagefind;
    } catch (e) {
      console.warn('Pagefind index not built — run `pnpm build` in docs/ first.');
      return null;
    }
  }

  function open() {
    root?.classList.remove('hidden');
    input?.focus();
  }
  function close() {
    root?.classList.add('hidden');
  }

  trigger?.addEventListener('click', () => {
    void ensure().then(open);
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      void ensure().then(open);
    } else if (e.key === 'Escape') {
      close();
    }
  });

  root?.addEventListener('click', (e) => {
    if (e.target === root) close();
  });

  let last = 0;
  input?.addEventListener('input', async () => {
    const q = input.value.trim();
    const id = ++last;
    if (!q) {
      results.innerHTML = '';
      return;
    }
    const pf = await ensure();
    if (!pf || id !== last) return;
    const search = await pf.search(q);
    if (id !== last) return;
    const data = await Promise.all(search.results.slice(0, 10).map((r: any) => r.data()));
    results.innerHTML = data
      .map(
        (d) => `
      <li class="rounded-md hover:bg-secondary/40">
        <a href="${d.url}" class="block px-3 py-2">
          <div class="text-sm font-semibold">${escapeHtml(d.meta.title ?? d.url)}</div>
          <div class="text-xs text-muted-foreground line-clamp-2">${d.excerpt}</div>
        </a>
      </li>
    `,
      )
      .join('');
  });

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  }
</script>
