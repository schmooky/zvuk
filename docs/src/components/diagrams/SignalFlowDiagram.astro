---
// Source → Voice gain → Bus input → FX chain → Bus output → Master → Destination
---
<svg viewBox="0 0 760 240" class="block w-full max-w-3xl mx-auto" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sf-grad" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0%" stop-color="hsl(186, 85%, 55%)" stop-opacity="0.0" />
      <stop offset="50%" stop-color="hsl(186, 85%, 55%)" stop-opacity="0.6" />
      <stop offset="100%" stop-color="hsl(38, 95%, 60%)" stop-opacity="0.0" />
    </linearGradient>
    <marker id="sf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="hsl(186, 85%, 55%)" opacity="0.7" />
    </marker>
  </defs>

  <!-- horizontal signal arrow line -->
  <line x1="40" y1="120" x2="720" y2="120" stroke="url(#sf-grad)" stroke-width="2" />

  <!-- nodes -->
  <g font-family="JetBrains Mono, ui-monospace, monospace" font-size="11">
    <!-- Source -->
    <rect x="40" y="86" width="92" height="68" rx="8" fill="hsl(220, 26%, 12%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.5" />
    <text x="86" y="115" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-weight="600">Source</text>
    <text x="86" y="135" text-anchor="middle" fill="hsl(215, 12%, 62%)" font-size="9">BufferSource</text>
    <line x1="132" y1="120" x2="178" y2="120" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.6" stroke-width="2" marker-end="url(#sf-arrow)" />

    <!-- Voice gain -->
    <rect x="178" y="86" width="92" height="68" rx="8" fill="hsl(220, 26%, 12%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.5" />
    <text x="224" y="115" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-weight="600">Voice gain</text>
    <text x="224" y="135" text-anchor="middle" fill="hsl(215, 12%, 62%)" font-size="9">jitter, fade</text>
    <line x1="270" y1="120" x2="316" y2="120" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.6" stroke-width="2" marker-end="url(#sf-arrow)" />

    <!-- Bus -->
    <rect x="316" y="60" width="160" height="120" rx="10" fill="hsl(220, 26%, 13%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.7" />
    <text x="396" y="80" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-weight="600" font-size="10">BUS</text>
    <rect x="328" y="92" width="60" height="34" rx="4" fill="hsl(220, 30%, 8%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" />
    <text x="358" y="113" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-size="9">input</text>
    <rect x="404" y="92" width="60" height="34" rx="4" fill="hsl(220, 30%, 8%)" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.4" />
    <text x="434" y="113" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-size="9">FX chain</text>
    <line x1="388" y1="109" x2="404" y2="109" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.5" stroke-width="1.5" marker-end="url(#sf-arrow)" />
    <rect x="366" y="138" width="60" height="32" rx="4" fill="hsl(220, 30%, 8%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" />
    <text x="396" y="158" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-size="9">output</text>
    <line x1="434" y1="126" x2="396" y2="138" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.5" stroke-width="1.5" />
    <line x1="476" y1="120" x2="522" y2="120" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.6" stroke-width="2" marker-end="url(#sf-arrow)" />

    <!-- Master -->
    <rect x="522" y="86" width="92" height="68" rx="8" fill="hsl(220, 26%, 12%)" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.6" />
    <text x="568" y="115" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-weight="600">Master</text>
    <text x="568" y="135" text-anchor="middle" fill="hsl(215, 12%, 62%)" font-size="9">headroom</text>
    <line x1="614" y1="120" x2="660" y2="120" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.6" stroke-width="2" marker-end="url(#sf-arrow)" />

    <!-- Destination -->
    <rect x="660" y="86" width="80" height="68" rx="8" fill="hsl(220, 26%, 12%)" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.6" />
    <text x="700" y="115" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-weight="600" font-size="10">Speakers</text>
    <text x="700" y="135" text-anchor="middle" fill="hsl(215, 12%, 62%)" font-size="9">ctx.destination</text>
  </g>
</svg>
