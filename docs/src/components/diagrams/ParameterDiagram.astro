---
---
<svg viewBox="0 0 720 220" class="block w-full max-w-2xl mx-auto" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="pd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="hsl(186, 85%, 55%)" opacity="0.7" />
    </marker>
  </defs>

  <g font-family="JetBrains Mono, ui-monospace, monospace" font-size="11">
    <!-- Parameter -->
    <g transform="translate(60, 80)">
      <rect width="160" height="80" rx="10" fill="hsl(186, 85%, 55%)" fill-opacity="0.15" stroke="hsl(186, 85%, 55%)" stroke-width="2" />
      <text x="80" y="22" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-weight="700">parameter</text>
      <text x="80" y="40" text-anchor="middle" fill="hsl(215, 12%, 80%)" font-size="10">"intensity"</text>
      <text x="80" y="62" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-weight="600">0.7</text>
    </g>

    <!-- Bound targets -->
    {[
      { y: 30, color: '186, 85%, 55%', from: 'bus("music").level', to: '0.4 → 1.0' },
      { y: 80, color: '38, 95%, 60%', from: 'reverb.wet',             to: '0.0 → 0.4' },
      { y: 130, color: '186, 85%, 55%', from: 'filter.frequency',     to: '400 → 8000' },
    ].map(({ y, color, from, to }) => (
      <g>
        <line x1="220" y1="120" x2={`${380}`} y2={`${y + 20}`} stroke={`hsl(${color})`} stroke-opacity="0.6" stroke-width="1.6" marker-end="url(#pd-arrow)" />
        <g transform={`translate(380, ${y})`}>
          <rect width="280" height="40" rx="6" fill="hsl(220, 26%, 13%)" stroke={`hsl(${color})`} stroke-opacity="0.45" />
          <text x="14" y="18" fill={`hsl(${color})`} font-size="10">{from}</text>
          <text x="14" y="32" fill="hsl(215, 12%, 60%)" font-size="9">range: {to}</text>
        </g>
      </g>
    ))}

    <!-- Bottom caption -->
    <text x="360" y="200" text-anchor="middle" fill="hsl(215, 12%, 60%)" font-size="10">
      one parameter.set(0.7) → every bound target updates with its mapped curve
    </text>
  </g>
</svg>
