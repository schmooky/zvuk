---
// cold → unlocking → live → closed
---
<svg viewBox="0 0 720 200" class="block w-full max-w-2xl mx-auto" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="sm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="hsl(186, 85%, 55%)" opacity="0.7" />
    </marker>
  </defs>

  <g font-family="JetBrains Mono, ui-monospace, monospace" font-size="11">
    <!-- States -->
    <g>
      <circle cx="80" cy="100" r="46" fill="hsl(220, 26%, 12%)" stroke="hsl(215, 12%, 40%)" stroke-width="2" />
      <text x="80" y="98" text-anchor="middle" fill="hsl(215, 12%, 80%)" font-weight="600">cold</text>
      <text x="80" y="115" text-anchor="middle" fill="hsl(215, 12%, 50%)" font-size="9">no ctx</text>
    </g>
    <g>
      <circle cx="260" cy="100" r="46" fill="hsl(220, 26%, 12%)" stroke="hsl(38, 95%, 60%)" stroke-width="2" stroke-dasharray="4 4" />
      <text x="260" y="95" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-weight="600" font-size="10">unlocking</text>
      <text x="260" y="113" text-anchor="middle" fill="hsl(215, 12%, 50%)" font-size="9">resume()…</text>
    </g>
    <g>
      <circle cx="440" cy="100" r="46" fill="hsl(186, 85%, 55%)" fill-opacity="0.12" stroke="hsl(186, 85%, 55%)" stroke-width="2.5" />
      <text x="440" y="98" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-weight="700">live</text>
      <text x="440" y="115" text-anchor="middle" fill="hsl(215, 12%, 60%)" font-size="9">audible</text>
    </g>
    <g>
      <circle cx="620" cy="100" r="46" fill="hsl(220, 26%, 12%)" stroke="hsl(0, 80%, 60%)" stroke-width="2" />
      <text x="620" y="98" text-anchor="middle" fill="hsl(0, 80%, 60%)" font-weight="600">closed</text>
      <text x="620" y="115" text-anchor="middle" fill="hsl(215, 12%, 50%)" font-size="9">terminal</text>
    </g>

    <!-- Transitions -->
    <line x1="126" y1="100" x2="214" y2="100" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.7" stroke-width="2" marker-end="url(#sm-arrow)" />
    <text x="170" y="90" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-size="9">unlock()</text>

    <line x1="306" y1="100" x2="394" y2="100" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.7" stroke-width="2" marker-end="url(#sm-arrow)" />
    <text x="350" y="90" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-size="9">resolved</text>

    <line x1="486" y1="100" x2="574" y2="100" stroke="hsl(0, 80%, 60%)" stroke-opacity="0.7" stroke-width="2" marker-end="url(#sm-arrow)" />
    <text x="530" y="90" text-anchor="middle" fill="hsl(0, 80%, 60%)" font-size="9">close()</text>

    <!-- close() also from cold/unlocking -->
    <path d="M80,146 Q80,180 350,180 Q620,180 620,146" fill="none" stroke="hsl(0, 80%, 60%)" stroke-opacity="0.4" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#sm-arrow)" />
    <text x="350" y="195" text-anchor="middle" fill="hsl(0, 80%, 60%)" font-size="9" opacity="0.7">close() at any time</text>
  </g>
</svg>
