---
// Voices queue with steal strategies
---
<svg viewBox="0 0 720 220" class="block w-full max-w-2xl mx-auto" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="cn-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="hsl(186, 85%, 55%)" opacity="0.7" />
    </marker>
  </defs>

  <g font-family="JetBrains Mono, ui-monospace, monospace" font-size="11">
    <text x="50" y="32" fill="hsl(215, 12%, 60%)" font-size="9" font-weight="600">SLOTS — max: 3, steal: oldest</text>

    <!-- Slots -->
    {[0, 1, 2].map((i) => (
      <g transform={`translate(${50 + i * 110}, 50)`}>
        <rect width="92" height="60" rx="8" fill="hsl(220, 26%, 13%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.5" />
        <text x="46" y="24" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-size="9">slot {i + 1}</text>
        <text x="46" y="44" text-anchor="middle" fill="hsl(215, 12%, 70%)" font-size="9">voice {String.fromCharCode(65 + i)}</text>
      </g>
    ))}

    <!-- Incoming -->
    <g transform="translate(380, 50)">
      <rect width="92" height="60" rx="8" fill="hsl(38, 95%, 60%)" fill-opacity="0.15" stroke="hsl(38, 95%, 60%)" stroke-width="2" />
      <text x="46" y="24" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-size="9">new!</text>
      <text x="46" y="44" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-weight="600">voice D</text>
    </g>

    <!-- Steal arrow from new → A -->
    <path d="M380,80 Q300,140 96,110" fill="none" stroke="hsl(0, 80%, 60%)" stroke-opacity="0.7" stroke-width="2" stroke-dasharray="5 5" marker-end="url(#cn-arrow)" />
    <text x="240" y="155" text-anchor="middle" fill="hsl(0, 80%, 60%)" font-size="9">A is the oldest → stolen, slot freed</text>

    <!-- Result -->
    <g transform="translate(50, 175)">
      <text x="0" y="14" fill="hsl(215, 12%, 60%)" font-size="9" font-weight="600">AFTER:</text>
      <text x="60" y="14" fill="hsl(215, 12%, 70%)" font-size="9">[ B  C  D ] — A.ended fires synchronously</text>
    </g>

    <!-- right column: alternative strategies -->
    <g transform="translate(500, 28)">
      <text x="0" y="0" fill="hsl(215, 12%, 60%)" font-size="9" font-weight="600">OTHER STRATEGIES</text>
      <g transform="translate(0, 14)">
        <rect width="180" height="22" rx="4" fill="hsl(220, 26%, 13%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.3" />
        <text x="8" y="15" fill="hsl(186, 85%, 55%)" font-size="9">lowest-priority</text>
      </g>
      <g transform="translate(0, 42)">
        <rect width="180" height="22" rx="4" fill="hsl(220, 26%, 13%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.3" />
        <text x="8" y="15" fill="hsl(186, 85%, 55%)" font-size="9">quietest</text>
      </g>
      <g transform="translate(0, 70)">
        <rect width="180" height="22" rx="4" fill="hsl(220, 26%, 13%)" stroke="hsl(0, 80%, 60%)" stroke-opacity="0.3" />
        <text x="8" y="15" fill="hsl(0, 80%, 60%)" font-size="9">none — reject new</text>
      </g>
    </g>
  </g>
</svg>
