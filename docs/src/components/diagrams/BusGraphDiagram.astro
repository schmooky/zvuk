---
// Several Sources → multiple Buses → Master → Destination
---
<svg viewBox="0 0 760 320" class="block w-full max-w-3xl mx-auto" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="bg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="hsl(186, 85%, 55%)" opacity="0.7" />
    </marker>
  </defs>

  <g font-family="JetBrains Mono, ui-monospace, monospace" font-size="10">
    <!-- Sources column -->
    <text x="80" y="22" text-anchor="middle" fill="hsl(215, 12%, 60%)" font-size="9" font-weight="600">SOURCES</text>
    <g transform="translate(40, 40)">
      {(['music.mp3', 'crowd.webm', 'coin.webm', 'click.webm', 'voice.m4a'] as const).map((label, i) => (
        <g transform={`translate(0, ${i * 50})`}>
          <rect width="80" height="34" rx="6" fill="hsl(220, 26%, 12%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" />
          <text x="40" y="22" text-anchor="middle" fill="hsl(215, 12%, 80%)" font-size="9">{label}</text>
        </g>
      ))}
    </g>

    <!-- Buses column -->
    <text x="380" y="22" text-anchor="middle" fill="hsl(38, 95%, 60%)" font-size="9" font-weight="600">BUSES</text>
    <g transform="translate(300, 50)">
      <rect width="160" height="60" rx="8" fill="hsl(220, 26%, 14%)" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.6" />
      <text x="14" y="22" fill="hsl(38, 95%, 60%)" font-weight="600" font-size="10">music</text>
      <text x="14" y="40" fill="hsl(215, 12%, 60%)" font-size="9">level 0.8 · concurrency 4</text>
      <text x="14" y="52" fill="hsl(215, 12%, 60%)" font-size="9">fx: reverb</text>
    </g>
    <g transform="translate(300, 130)">
      <rect width="160" height="60" rx="8" fill="hsl(220, 26%, 14%)" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.6" />
      <text x="14" y="22" fill="hsl(38, 95%, 60%)" font-weight="600" font-size="10">sfx</text>
      <text x="14" y="40" fill="hsl(215, 12%, 60%)" font-size="9">level 1.0 · concurrency 32</text>
      <text x="14" y="52" fill="hsl(215, 12%, 60%)" font-size="9">steal: oldest</text>
    </g>
    <g transform="translate(300, 210)">
      <rect width="160" height="60" rx="8" fill="hsl(220, 26%, 14%)" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.6" />
      <text x="14" y="22" fill="hsl(38, 95%, 60%)" font-weight="600" font-size="10">voice</text>
      <text x="14" y="40" fill="hsl(215, 12%, 60%)" font-size="9">level 1.0 · ducks music</text>
      <text x="14" y="52" fill="hsl(215, 12%, 60%)" font-size="9">fx: ducker(from: voice)</text>
    </g>

    <!-- Master + dest -->
    <text x="600" y="22" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-size="9" font-weight="600">MASTER</text>
    <rect x="540" y="120" width="120" height="60" rx="8" fill="hsl(186, 85%, 55%)" fill-opacity="0.12" stroke="hsl(186, 85%, 55%)" stroke-width="2" />
    <text x="600" y="148" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-weight="700">Master</text>
    <text x="600" y="168" text-anchor="middle" fill="hsl(215, 12%, 60%)" font-size="9">headroom -3 dB</text>

    <rect x="680" y="120" width="60" height="60" rx="8" fill="hsl(220, 26%, 14%)" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.6" />
    <text x="710" y="148" text-anchor="middle" fill="hsl(186, 85%, 55%)" font-size="10">🔊</text>
    <text x="710" y="168" text-anchor="middle" fill="hsl(215, 12%, 60%)" font-size="9">dest</text>

    <!-- Source → Bus arrows -->
    <line x1="120" y1="57" x2="300" y2="80" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#bg-arrow)" />
    <line x1="120" y1="107" x2="300" y2="160" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#bg-arrow)" />
    <line x1="120" y1="157" x2="300" y2="160" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#bg-arrow)" />
    <line x1="120" y1="207" x2="300" y2="160" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#bg-arrow)" />
    <line x1="120" y1="257" x2="300" y2="240" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#bg-arrow)" />

    <!-- Bus → Master arrows -->
    <line x1="460" y1="80" x2="540" y2="140" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.5" stroke-width="1.5" marker-end="url(#bg-arrow)" />
    <line x1="460" y1="160" x2="540" y2="150" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.5" stroke-width="1.5" marker-end="url(#bg-arrow)" />
    <line x1="460" y1="240" x2="540" y2="160" stroke="hsl(38, 95%, 60%)" stroke-opacity="0.5" stroke-width="1.5" marker-end="url(#bg-arrow)" />

    <!-- Master → Dest -->
    <line x1="660" y1="150" x2="680" y2="150" stroke="hsl(186, 85%, 55%)" stroke-opacity="0.7" stroke-width="2" marker-end="url(#bg-arrow)" />

    <!-- Sidechain key from voice → music -->
    <path d="M380,160 Q260,180 260,80" fill="none" stroke="hsl(0, 80%, 60%)" stroke-opacity="0.5" stroke-width="1.2" stroke-dasharray="3 3" />
    <text x="200" y="280" fill="hsl(0, 80%, 60%)" font-size="9" opacity="0.8">sidechain (voice → music)</text>
  </g>
</svg>
