---
import SpatialPanner from '../../components/demos/SpatialPanner.tsx';
import Frame from '../../components/diagrams/Frame.astro';
import SpatialDiagram from '../../components/diagrams/SpatialDiagram.astro';
import Since from '../../components/Since.astro';
import Snippet from '../../components/Snippet.astro';
import Docs from '../../layouts/Docs.astro';

const listener = `// A top-down game: the camera is the listener.
engine.listener.setPosition(player.x, 0, player.y);
engine.listener.setOrientation([Math.sin(player.angle), 0, -Math.cos(player.angle)]);

// Snap instead of glide on a teleport, then restore.
engine.listener.setGlide(0);
engine.listener.setPosition(spawn.x, 0, spawn.y);
engine.listener.setGlide(0.02);`;

const glide = `const v = engine.sound('drone').play({
  loop: true,
  spatializer: {
    position: [0, 0, -5],
    glide: 0.05,              // smoother for a slow-moving source
    panningModel: 'equalpower', // a crowd of 40 positioned voices: skip HRTF
  },
});

// Per frame: no zipper noise, the position eases toward each new target.
v.spatializer?.setPosition(x, 0, z);`;

const pan2d = `engine.sound('footstep').play({
  spatializer: { pan: -0.6 },              // [-1, 1] stereo
});`;

const pos3d = `engine.sound('footstep').play({
  spatializer: { position: [x, y, z] },    // world-space coords
});`;

const dynamic = `import { Spatializer } from '@schmooky/zvuk';

const sp = new Spatializer(engine.context, { position: [0, 0, 0] });
// connectInto() wires the spatializer to the bus and RETURNS the node your
// source should feed into — route your source there, or you'll get silence.
const input = sp.connectInto(engine.bus('sfx').input);
mySourceNode.connect(input);
sp.setPosition(playerX, playerY, playerZ);    // each frame

// when done:
sp.dispose();`;

const livePerVoice = `// The spawned voice exposes its Spatializer for live steering.
const v = engine.sound('engine').play({
  loop: true,
  spatializer: { position: [0, 0, 0] },
});

requestAnimationFrame(function tick() {
  if (v.spatializer) v.spatializer.setPosition(player.x, 0, player.z);
  requestAnimationFrame(tick);
});

// 2D — same shape with setPan.
const swarm = engine.sound('bee').play({ spatializer: { pan: 0 } });
swarm.spatializer?.setPan(-0.6);`;

const distance3D = `// 3D config exposed: tune the distance-attenuation curve to your scene.
engine.sound('engine').play({
  spatializer: {
    position: [10, 0, 0],
    refDistance: 5,            // full volume within 5 units of the listener
    maxDistance: 250,          // 'linear' model reaches zero here
    rolloffFactor: 1.5,        // steeper than the natural rolloff
    distanceModel: 'inverse',  // 'linear' | 'inverse' | 'exponential'
  },
});

// Live setters for moving sources / dynamic environments:
v.spatializer?.setRefDistance(8);
v.spatializer?.setMaxDistance(500);
v.spatializer?.setRolloffFactor(2);
v.spatializer?.setDistanceModel('linear');`;

const occlusion = `// Occlusion — single 0..1 knob driving an internal lowpass + small gain dip.
// 0 = clear; 1 = behind a wall (cutoff sweeps to ~500 Hz, level drops -6 dB).
engine.sound('boss-roar').play({
  spatializer: { position: [50, 0, 0], occlusion: 0 },
});

// Drive it from a Parameter so a single knob can occlude every relevant voice.
const occlusion = engine.parameter('boss-occlusion', 0);
v.spatializer && occlusion.bindTo((amount) => v.spatializer!.setOcclusion(amount));
occlusion.set(0.7);          // boss is now mostly muffled

// Combine with distance for a "behind a wall, far away" feel — bind the
// same parameter to both setOcclusion() and a position update.`;
---
<Docs
  title="Spatializer"
  description="Stereo pan or full 3D positional audio. PannerNode wrapped, HRTF on by default."
  eyebrow="Concept"
>
  <p>
    A footstep behind you and a footstep in front of you are the same sample.
    What tells them apart is where the engine puts it, and the browser will
    do that for you if you hand it a position.
  </p>
  <p>
    A <a href="/api/Spatializer/"><code>Spatializer</code></a> sits between one
    voice and its bus, as either a <code>StereoPannerNode</code> for a flat
    left-right pan or a <code>PannerNode</code> in HRTF mode for a position in
    3D. Pass <code>spatializer</code> to <code>play()</code> for a fixed
    placement. For a source that moves, hold the object and update it per
    frame.
  </p>

  <h2>Mental model</h2>
  <Frame caption="2D pan is cheap (StereoPannerNode). 3D uses PannerNode in HRTF mode, one node per voice.">
    <SpatialDiagram />
  </Frame>

  <h2>API surface</h2>
  <Snippet code={`interface SpatialOptions {
  pan?: number;                        // [-1, 1] — 2D
  position?: [number, number, number]; // x, y, z  — 3D
  refDistance?: number;                // 3D, default 1
  maxDistance?: number;                // 3D, default 10000
  rolloffFactor?: number;              // 3D, default 1
  distanceModel?: 'linear' | 'inverse' | 'exponential';
  occlusion?: number;                  // 3D, 0..1
  panningModel?: 'HRTF' | 'equalpower'; // v2, 3D, default 'HRTF'
  glide?: number;                      // v2, seconds, default 0.02
}

class Spatializer {
  setPan(pan: number): void;                           // 2D; glides (v2)
  setPosition(x: number, y: number, z: number): void;  // 3D; glides (v2)
  setOcclusion(amount: number): void;                  // 3D; glides (v2)
  setGlide(seconds: number): void;                     // v2
  setPanningModel(model: 'HRTF' | 'equalpower'): void; // v2
  setRefDistance(d: number): void;
  setMaxDistance(d: number): void;
  setRolloffFactor(f: number): void;
  setDistanceModel(m: DistanceModel): void;
  connectInto(dest: AudioNode): AudioNode;
  dispose(): void;
}

class Listener {                                       // v2: engine.listener
  setPosition(x: number, y: number, z: number): void;
  setOrientation(forward: [number, number, number], up?: [number, number, number]): void;
  setGlide(seconds: number): void;                     // default 0.02
  readonly position: [number, number, number];
}`} lang="ts" title="Spatializer + SpatialOptions" />

  <h2>Live demo</h2>
  <p>Drag the puck to pan a looping sound. Best with headphones.</p>
  <SpatialPanner client:visible />

  <h2>Recipes</h2>

  <h3>2D pan from play()</h3>
  <Snippet code={pan2d} lang="ts" />

  <h3>3D position from play()</h3>
  <Snippet code={pos3d} lang="ts" />

  <h3>Dynamic position — moving source</h3>
  <Snippet code={dynamic} lang="ts" />

  <h3>Live binding from the spawned Voice</h3>
  <p>
    Spawning with <code>spatializer</code> stores the node on the returned
    voice, so there is nothing to re-attach and no second reference to keep
    in sync.
  </p>
  <Snippet code={livePerVoice} lang="ts" />

  <h3>3D distance config <Since v="1.10" /></h3>
  <p>
    Four values, available both as construction options and as live setters.
    <code>refDistance</code> is the radius inside which nothing attenuates.
    <code>maxDistance</code> anchors the far end of the rolloff curve.
    <code>rolloffFactor</code> scales how hard distance bites.
    <code>distanceModel</code> picks the curve shape, one of
    <code>'inverse'</code>, <code>'linear'</code> or
    <code>'exponential'</code>.
  </p>
  <Snippet code={distance3D} lang="ts" />

  <h3>Occlusion — "behind a wall" <Since v="1.10" /></h3>
  <p>
    One knob from 0 to 1, driving an internal lowpass whose cutoff sweeps
    logarithmically from 22050 Hz down to about 500 Hz, plus a gain dip
    reaching -6 dB at full amount. That is roughly what a wall does to a
    sound. Bind it to a <a href="/concepts/parameter/">Parameter</a> and one
    handle moves the whole room.
  </p>
  <Snippet code={occlusion} lang="ts" />

  <h3>The listener <Since v="2.0" /></h3>
  <p>
    Sources were positioned relative to a listener frozen at the origin
    facing -z, which suits a fixed camera and nothing else.
    <code>engine.listener</code> moves and turns it. <code>forward</code> is
    where the nose points and <code>up</code> the top of the head (default
    +y). Changes glide like the spatializers do, and browsers that only have
    the deprecated <code>setPosition</code>/<code>setOrientation</code>
    methods on <code>AudioListener</code> are covered.
  </p>
  <Snippet code={listener} lang="ts" />

  <h3>Glide and panning model <Since v="2.0" /></h3>
  <p>
    Jumping a panner's position every frame crackles, because each jump is a
    step in the filter coefficients. In v2 <code>setPan</code>,
    <code>setPosition</code> and <code>setOcclusion</code> ease toward the
    new value with a time constant, <code>glide</code>, of 20 ms by default:
    about 95% of the way there after three of them. Pass 0 for instant
    jumps. <code>panningModel: 'equalpower'</code> drops HRTF, which sounds
    worse on headphones and costs far less; use it for speakers or for
    dozens of positioned voices.
  </p>
  <Snippet code={glide} lang="ts" />

  <h2>Pitfalls</h2>
  <div class="pitfall">
    <div class="pitfall-title">Don't 3D-spatialize music.</div>
    Music wants to feel wide, not located. HRTF on a stereo music bus is an
    audible downgrade. Pan it manually if you want a side bias.
  </div>
  <div class="pitfall">
    <div class="pitfall-title">Don't construct a Spatializer per frame.</div>
    HRTF nodes are cheap but not free. Hold one per emitter and call
    <code>setPosition</code> on it.
  </div>

  <h2>Related</h2>
  <ul>
    <li><a href="/concepts/voice/">Voice</a> is what gets spatialized.</li>
    <li><a href="/concepts/bus/">Bus</a> is what a spatializer routes into.</li>
    <li><a href="/examples/spatializer/">Spatializer example</a> moves a source and the listener.</li>
  </ul>
</Docs>
