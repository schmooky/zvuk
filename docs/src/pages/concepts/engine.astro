---
import CrossfadeDemo from '../../components/demos/CrossfadeDemo.tsx';
import MixerDashboard from '../../components/demos/MixerDashboard.tsx';
import Frame from '../../components/diagrams/Frame.astro';
import SignalFlowDiagram from '../../components/diagrams/SignalFlowDiagram.astro';
import StateMachineDiagram from '../../components/diagrams/StateMachineDiagram.astro';
import Since from '../../components/Since.astro';
import Snippet from '../../components/Snippet.astro';
import Docs from '../../layouts/Docs.astro';

const create = `import { createEngine } from '@schmooky/zvuk';

const engine = createEngine({
  buses: {
    music: { level: 0.8 },
    sfx:   { level: 1.0 },
    voice: { level: 1.0 },
  },
  master: { headroom: -3 },
});`;

const lifecycle = `await engine.unlock();          // call from a user gesture
engine.state;                    // 'cold' | 'unlocking' | 'live' | 'suspended' | 'interrupted' | 'closed'

await engine.loadSound('coin', '/sfx/coin.webm', { bus: 'sfx' });
engine.sound('coin').play();

await engine.close();            // terminal — construct a new engine if needed`;

const observe = `const off = engine.onStateChange((s) => {
  if (s === 'live') console.log('audio is live; ctx time:', engine.now);
});
// later: off();`;

const schedule = `const beat = engine.now + 0.25;          // 250 ms ahead in audio time
engine.scheduleAt(beat, () => engine.sound('downbeat').play());`;

const pauseMenu = `pauseButton.onclick = async () => {
  await engine.suspend();   // the audio clock stops; scheduled work waits
  showPauseMenu();
};

resumeButton.onclick = async () => {
  hidePauseMenu();
  await engine.resume();
};`;

const unload = `// Leaving the bonus round: drop everything it loaded, whatever kind it was.
for (const name of ['bonus-theme', 'bonus-sprite', 'bonus-coins', 'bonus-rain']) {
  engine.unload(name);                       // evicts the decoded buffer too
}
engine.unload('ui-click', { evictBuffer: false }); // keep the buffer cached

// Reloading a name replaces the asset. Old music voices stop, an old stream
// is disposed; voices of an old sound play out.
await engine.loadMusic('theme', { loop: ['/music/theme-v2.webm', '/music/theme-v2.m4a'] });`;

const teardown = `// React example
useEffect(() => () => { void engine.close(); }, []);

// Vue example
onBeforeUnmount(() => { void engine.close(); });

// Plain SPA
router.beforeEach(async () => { await engine.close(); });`;

const config = `interface EngineConfig {
  buses?: Record<string, BusConfig>;
  master?: { volume?: number; mute?: boolean; headroom?: number; limiter?: MasterLimiterConfig };
  voice?: VoiceDefaults;

  latencyHint?: 'interactive' | 'balanced' | 'playback' | number;
  cache?: { maxBytes?: number; maxEntries?: number };   // 64 MiB, 128 entries
  tickSource?: TickSource;                               // e.g. Pixi app.ticker
  resolveAsset?: AssetResolver;                          // adopt buffers you already have
  autoPauseOnHidden?: boolean;                           // default true
}`;

const latency = `// A music player: longer buffers, less CPU, nobody is waiting on a tap.
const player = createEngine({ buses: { music: {} }, latencyHint: 'playback' });

// A game: the default, written out.
const game = createEngine({ buses: { sfx: {} }, latencyHint: 'interactive' });`;

const cache = `const engine = createEngine({
  buses: { sfx: {}, music: {} },
  // Decoded PCM is 4 bytes per sample per channel, so 32 MiB holds about
  // 85 seconds of 48 kHz stereo. The LRU evicts on whichever limit hits first.
  cache: { maxBytes: 32 * 1024 * 1024, maxEntries: 64 },
});`;

const surface = `interface Engine {
  readonly state: 'cold' | 'unlocking' | 'live' | 'suspended' | 'interrupted' | 'closed';
  readonly now: number;
  readonly context: AudioContext;

  readonly master: Master;               // v2
  readonly listener: Listener;           // v2

  unlock(): Promise<void>;
  suspend(): Promise<void>;              // v2: a pause the tab return won't undo
  resume(): Promise<void>;               // v2
  close(): Promise<void>;

  loadSound(name: string, url: string | readonly string[], options?: LoadSoundOptions): Promise<Sound>;
  loadSprite(name: string, url, regions: SpriteMap, options?): Promise<Sprite>;
  loadStream(name: string, url: string | readonly string[], options?): StreamSound;
  hasSound(name: string): boolean;
  hasSprite(name: string): boolean;
  hasStream(name: string): boolean;
  unload(name: string, opts?: { evictBuffer?: boolean }): void;   // v2: any kind

  sound(name: string): Sound;            // throws SoundNotFoundError ("did you mean…")
  sprite(name: string): Sprite;
  stream(name: string): StreamSound;
  bus(name: string): Bus;                // throws BusNotFoundError ("did you mean…")

  crossfade(from: string, to: string, opts?: CrossfadeOptions): Voice;
  scheduleAt(audioTime: number, fn: () => void): () => void;

  parameter(name: string, initial?: number): Parameter;
  captureSnapshot(name: string): Snapshot;

  activeVoices(): readonly Voice[];
  masterMeter(): AudioLevel;             // deprecated in v2: engine.master.meter()
  onStateChange(fn: (s: EngineState) => void): () => void;
}`;

const sprites = `// One buffer, three regions — the cascade SFX share a single fetch + decode.
await engine.loadSprite('cascade', '/sfx/cascade.webm', {
  small:  { start: 0,    duration: 0.2 },
  medium: { start: 0.25, duration: 0.4 },
  big:    { start: 0.7,  duration: 0.6 },
}, { bus: 'sfx' });

engine.sprite('cascade').play('medium', { volume: { jitter: 0.05 } });`;

const streams = `// Multi-minute music — don't decode a 4-min track into RAM.
const music = engine.loadStream('intro', '/music/intro.m4a', { bus: 'music' });
await music.play({ loop: true, volume: 0.6 });
await music.fade({ to: 0, duration: 1.5 });
music.stop();`;

const crossfade = `// 1.5-second equal-power crossfade between two pre-loaded music tracks.
await engine.loadSound('intro', '/music/intro.webm', { bus: 'music', normalize: true });
await engine.loadSound('main',  '/music/main.webm',  { bus: 'music', normalize: true });

engine.sound('intro').play({ loop: true });
// Later — at the boss reveal.
engine.crossfade('intro', 'main', { duration: 1.5, loop: true });`;

const didYouMean = `// Typo? The error tells you what you meant.
try {
  engine.bus('sxf');
} catch (e) {
  // BusNotFoundError: Bus "sxf"; did you mean "sfx" is not configured. ...
}`;
---
<Docs
  title="Engine"
  description="The root object. Owns the AudioContext, the bus graph, the scheduler, and every loaded sound."
  eyebrow="Concept"
>
  <p>
    Constructing an <code>AudioContext</code> at module load used to be
    normal. Then browsers made autoplay a permission, and now the context you
    built before the user touched anything starts suspended, stays suspended,
    and swallows every sound you play through it.
  </p>
  <p>
    The engine is the root object and the only one you construct directly.
    Buses, sounds, voices, parameters and snapshots are all reached through
    it. It holds the <code>AudioContext</code>, the bus graph, the scheduler,
    and every loaded asset. The context is created on first use rather than
    in the constructor, so <code>createEngine()</code> is safe to call before
    any user interaction. See <a href="/api/Engine/"><code>Engine</code></a>
    for the full surface.
  </p>

  <h2>How do I unlock audio on iOS Safari?</h2>
  <p>
    Call <code>await engine.unlock()</code> from inside a real user gesture:
    a click, a tap, a keydown. It is idempotent, and repeated calls return the
    same in-flight promise, so wiring it to several handlers is fine.
    Visibility and focus changes suspend and resume the context on their own
    afterwards.
  </p>

  <h2>State machine</h2>
  <p>
    Six states, one terminal transition. <code>suspended</code> covers a tab
    that went to the background. <code>interrupted</code> is the iOS state for
    a phone call or Siri taking the audio session, which
    <code>resume()</code> cannot recover from on its own.
  </p>
  <Frame caption="Engine lifecycle. unlock() is idempotent and returns the same in-flight promise.">
    <StateMachineDiagram />
  </Frame>

  <h2>Signal flow</h2>
  <p>
    Each <code>play()</code> call attaches a voice to its bus's input node.
    Voices feed through the bus FX chain if there is one, out of the bus
    output, into master, and on to <code>ctx.destination</code>. Everything
    else in the library is a variation on this graph.
  </p>
  <Frame title="signal flow">
    <SignalFlowDiagram />
  </Frame>

  <h2>API surface</h2>
  <Snippet code={surface} lang="ts" title="The Engine interface" />

  <h2>Configuration</h2>
  <p>
    Everything <code>createEngine()</code> accepts. Only <code>buses</code>
    is something you will set on every project; the rest have defaults that
    suit a game in a foreground tab.
  </p>
  <Snippet code={config} lang="ts" title="EngineConfig" />

  <h3>latencyHint <Since v="1.11" /></h3>
  <p>
    Passed straight to <code>AudioContextOptions.latencyHint</code>.
    <code>'interactive'</code> is the browser default and the right call
    when a tap has to sound immediately. <code>'playback'</code> trades
    latency for larger buffers and less CPU, which suits a music player or a
    podcast tool. A number asks for that many seconds, and browsers treat it
    as a request rather than a promise. The hint only matters before the
    context exists, so it has to go in the config, not on a running engine.
  </p>
  <Snippet code={latency} lang="ts" />

  <h3>Decoded-buffer cache <Since v="1.14" /></h3>
  <p>
    Every decoded buffer goes into an LRU cache keyed by URL, so a second
    <code>loadSound</code> of the same file costs nothing and two concurrent
    loads share one fetch. The budget is in bytes because an entry count says
    nothing about memory. One minute of stereo at 48 kHz decodes to about
    23 MB. The defaults are 64 MiB and 128 entries, and both limits apply.
    <code>engine.unloadSound(name)</code> evicts one entry on purpose.
  </p>
  <Snippet code={cache} lang="ts" />
  <p>
    <code>tickSource</code> and <code>autoPauseOnHidden</code> are covered in
    <a href="/guides/runtime-timing/">Runtime timing</a>;
    <code>resolveAsset</code> in <a href="/guides/asset-resolution/">Asset resolution</a>;
    <code>master</code> on the <a href="/concepts/master/">Master bus</a> page,
    which is also where <code>engine.master</code> <Since v="2.0" /> lives.
  </p>

  <h2>Live demo</h2>
  <p>
    The dashboard below runs three buses, six samples in
    <code>.webm</code>/<code>.m4a</code> pairs, and a voice counter that
    updates as voices start and end.
  </p>
  <MixerDashboard client:visible />

  <h2>Recipes</h2>

  <h3>Build at module load, unlock on click</h3>
  <Snippet code={create} lang="ts" />
  <Snippet code={lifecycle} lang="ts" />

  <h3>Watch state transitions</h3>
  <Snippet code={observe} lang="ts" />

  <h3>Audio-clock scheduling</h3>
  <p>
    <code>scheduleAt</code> dispatches a callback against the audio clock. It
    runs on the main thread, so the drift is bounded by one tick, a few
    milliseconds. It is not sample-accurate. When you need that, stamp the Web
    Audio parameter itself with the audio time and let the audio thread do the
    work: <code>source.start(t)</code>, or
    <code>gain.linearRampToValueAtTime(v, t)</code>.
  </p>
  <Snippet code={schedule} lang="ts" />

  <h3>Audio sprites: one buffer, many regions</h3>
  <p>
    Sprites suit low-latency one-shots that can share a buffer. Cascades, UI
    variants, dialogue chunks. One fetch, one decode, and voices bound to a
    named region of the result.
  </p>
  <Snippet code={sprites} lang="ts" />

  <h3>Stream long media instead of decoding it</h3>
  <p>
    Past about thirty seconds, prefer <code>loadStream</code> over
    <code>loadSound</code>. Decoded audio costs four bytes per sample per
    channel, so three minutes of stereo at 48 kHz is roughly 70 MB of resident
    memory. A stream reads progressively through an
    <code>HTMLAudioElement</code>, which is also the path iOS Safari is
    happiest with.
  </p>
  <Snippet code={streams} lang="ts" />

  <h3>Crossfade music tracks in one call</h3>
  <p>
    Equal-power by default, so perceived loudness stays flat across the swap
    instead of dipping in the middle. Outgoing voices are matched by
    <code>sourceName</code>.
  </p>
  <Snippet code={crossfade} lang="ts" />
  <CrossfadeDemo client:visible />

  <h3>"Did you mean…" lookups</h3>
  <p>
    A misspelled bus or sound name produces an error carrying the closest
    declared name, by Levenshtein distance. It is a small thing that saves an
    afternoon roughly once per project.
  </p>
  <Snippet code={didYouMean} lang="ts" />

  <h3>Pause menu: suspend and resume <Since v="2.0" /></h3>
  <p>
    <code>autoPauseOnHidden</code> suspends the context when the tab is
    hidden and resumes it when the tab comes back. That second half is
    wrong for a pause menu. Switch tabs while paused and the game starts
    making noise behind the menu. <code>engine.suspend()</code> is a
    suspend the app owns. Tab return leaves it alone; only
    <code>resume()</code> (or <code>unlock()</code>) ends it. The engine
    reports <code>'suspended'</code> meanwhile, and because the audio clock
    stops, voices, fades and <code>scheduleAt</code> callbacks pick up where
    they were.
  </p>
  <Snippet code={pauseMenu} lang="ts" />

  <h3>Unload anything, reload safely <Since v="2.0" /></h3>
  <p>
    <code>engine.unload(name)</code> takes a sound, sprite, variants bundle,
    music or stream. Music and streams under that name are stopped; voices
    of sounds, sprites and variants play out. <code>evictBuffer</code>
    (default <code>true</code>) also drops the decoded buffers from the
    cache. Loading a name that already exists replaces it with the same
    stop rules, where 1.x left the old stream wired to its bus with no
    handle to stop it.
  </p>
  <Snippet code={unload} lang="ts" />

  <h3>Tear down on route change</h3>
  <Snippet code={teardown} lang="ts" />

  <h2>Pitfalls</h2>
  <div class="pitfall">
    <div class="pitfall-title">Don't construct the engine inside a click handler.</div>
    Construct it at module load. <code>createEngine</code> is cheap; only
    <code>unlock()</code> needs a user gesture.
  </div>
  <div class="pitfall">
    <div class="pitfall-title">Don't call play() before unlock.</div>
    On iOS Safari the AudioContext starts <code>suspended</code>. Sounds will be silently
    dropped. Always <code>await engine.unlock()</code> first.
  </div>
  <div class="pitfall">
    <div class="pitfall-title">Don't reuse a closed engine.</div>
    <code>close()</code> is terminal. Construct a fresh one if you need audio again.
  </div>

  <h2>Related</h2>
  <ul>
    <li><a href="/concepts/mixer/">Mixer</a> is the bus graph rooted at the engine.</li>
    <li><a href="/concepts/bus/">Bus</a> covers routing, level, mute and fade.</li>
    <li><a href="/concepts/voice/">Voice</a> is what <code>play()</code> returns.</li>
    <li><a href="/guides/errors/">Errors</a> lists what each engine call throws.</li>
  </ul>
</Docs>
