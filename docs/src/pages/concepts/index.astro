---
import CardGrid from '../../components/CardGrid.astro';
import Docs from '../../layouts/Docs.astro';

const concepts = [
  { slug: 'engine',       label: 'Engine',       blurb: 'The root object. Lifecycle, unlock, scheduler.' },
  { slug: 'master',       label: 'Master bus',   blurb: 'Headroom, limiter and the meter at the top of the graph.' },
  { slug: 'mixer',        label: 'Mixer',        blurb: 'The named bus graph. Routing made declarative.' },
  { slug: 'bus',          label: 'Bus',          blurb: 'A mix bucket with level, fade, FX and a voice limit.' },
  { slug: 'sound',        label: 'Sound',        blurb: 'A loaded sample. Spawns Voices on play.' },
  { slug: 'music',        label: 'Music',        blurb: 'Stinger, loop, outro. Skip to the outro at the next loop boundary.' },
  { slug: 'voice',        label: 'Voice',        blurb: 'One playback instance. Cues, fades, abort.' },
  { slug: 'concurrency',  label: 'Concurrency',  blurb: 'Voice limits and steal strategies.' },
  { slug: 'snapshot',     label: 'Snapshot',     blurb: 'Capture the mix; crossfade between presets.' },
  { slug: 'parameter',    label: 'Parameter',    blurb: 'A named knob. Bind it to anything.' },
  { slug: 'spatializer',  label: 'Spatializer',  blurb: 'Stereo pan or 3D position per voice.' },
];
---
<Docs
  title="Concepts"
  description="The vocabulary you need to think in zvuk."
  eyebrow="Concepts"
>
  <p>
    These pages are the vocabulary. Read them in any order; they
    cross-link. If you would rather click than read, the
    <a href="/recipes/">recipes</a> are short and each one runs.
  </p>

  <CardGrid cards={concepts.map((c) => ({ href: `/concepts/${c.slug}/`, title: c.label, body: c.blurb }))} />
</Docs>
