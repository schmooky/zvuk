---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/seo';
import api from '../../content/api.json';

interface ApiSymbol {
  id: number;
  name: string;
  kindString?: string;
  comment?: { summary?: { text?: string }[] };
}

const children: ApiSymbol[] = (api?.children ?? []) as ApiSymbol[];
const groups = new Map<string, ApiSymbol[]>();
for (const c of children) {
  const k = c.kindString ?? 'Other';
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(c);
}
const ordered = Array.from(groups.entries()).sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title={`API · ${SITE.name}`} description="Auto-generated TypeDoc reference for every public symbol.">
  <div class="container py-12 max-w-4xl">
    <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">Reference</div>
    <h1 class="mb-3 text-4xl font-semibold tracking-tight">API</h1>
    <p class="mb-8 text-lg text-muted-foreground max-w-2xl">
      Generated by TypeDoc on every build from <code class="rounded bg-secondary/60 px-1 py-0.5 font-mono text-sm">src/index.ts</code>.
      The narrative concept pages are still the best way to learn — this index is for "I know the name, link me to it."
    </p>

    {children.length === 0 ? (
      <div class="rounded-xl border border-border bg-card/40 p-6 text-sm text-muted-foreground">
        No entries yet. Run <code class="rounded bg-secondary/60 px-1 py-0.5 font-mono">pnpm api:gen</code> from <code>docs/</code>.
      </div>
    ) : (
      ordered.map(([kind, items]) => (
        <section class="mb-10">
          <h2 class="mb-3 text-xs font-mono uppercase tracking-[0.14em] text-muted-foreground">{kind}</h2>
          <ul class="grid gap-2 sm:grid-cols-2">
            {items.map((c) => (
              <li>
                <a
                  href={`/api/${c.name}/`}
                  class="block rounded-lg border border-border bg-card/30 p-3 transition-colors hover:border-primary/40 hover:bg-card/60"
                >
                  <div class="font-mono text-sm font-semibold">{c.name}</div>
                  {c.comment?.summary?.[0]?.text && (
                    <div class="mt-1 text-xs text-muted-foreground line-clamp-2">{c.comment.summary[0].text}</div>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </div>
</Base>
