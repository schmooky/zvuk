---
import Docs from '../../layouts/Docs.astro';

const fx = [
  { slug: 'compressor', label: 'Compressor', blurb: 'Tame transients. Glue voices on a bus. Live gain-reduction meter.' },
  { slug: 'pitch',      label: 'Pitch & time-stretch', blurb: 'Cheap rate change vs. pitch-preserving granular stretch.' },
  { slug: 'reverb',     label: 'Reverb', blurb: 'Convolution with synthetic IR or your own impulse response.' },
  { slug: 'filter',     label: 'Filter', blurb: 'Biquad — lowpass, highpass, bandpass, notch, peaking, allpass.' },
  { slug: 'ducker',     label: 'Ducker', blurb: 'Sidechain compression: drop one bus when another speaks.', href: '/guides/ducking/' },
];
---
<Docs
  title="FX"
  description="Real DSP, real graphs. Inserts on any bus or composed standalone."
  eyebrow="Reference"
>
  <p>
    Every effect here is a small class implementing the same
    <a href="/api/FxInsert/"><code>FxInsert</code></a> contract. It has an <code>input</code> node, an
    <code>output</code> node, a <code>bypassed</code> toggle, and a
    <code>dispose()</code>. Hand one to <code>bus.addFx(fx)</code> and the bus
    splices it into its chain between input and output, in the order you
    added it.
  </p>

  <div class="not-prose mt-6 grid gap-3 sm:grid-cols-2">
    {fx.map(({ slug, label, blurb, href }) => (
      <a
        href={href ?? `/fx/${slug}/`}
        class="rounded-xl border border-border bg-card/40 p-4 transition-colors hover:border-primary/50 hover:bg-primary/[0.04]"
      >
        <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">{href ?? `/fx/${slug}/`}</div>
        <div class="mt-1 font-semibold">{label}</div>
        <div class="mt-1 text-sm text-muted-foreground">{blurb}</div>
      </a>
    ))}
  </div>
</Docs>
