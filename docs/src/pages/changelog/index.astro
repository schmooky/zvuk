---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/seo';
import entries from '../../content/changelog.json';

interface ChangelogEntry {
  id: string;
  bump: 'major' | 'minor' | 'patch';
  title: string;
  body: string;
}

const list = (entries ?? []) as ChangelogEntry[];

const bumpStyle = {
  major: 'border-destructive/40 bg-destructive/10 text-destructive',
  minor: 'border-accent/40 bg-accent/10 text-accent',
  patch: 'border-primary/40 bg-primary/10 text-primary',
};
---
<Base title={`Changelog · ${SITE.name}`} description="Every changeset rendered as a single timeline.">
  <div class="container py-12 max-w-4xl">
    <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">Releases</div>
    <h1 class="mb-3 text-4xl font-semibold tracking-tight">Changelog</h1>
    <p class="mb-8 text-lg text-muted-foreground max-w-2xl">
      Built from <code class="rounded bg-secondary/60 px-1 py-0.5 font-mono text-sm">.changeset/*.md</code> on every deploy.
    </p>

    {list.length === 0 ? (
      <div class="rounded-xl border border-border bg-card/40 p-6 text-sm text-muted-foreground">
        No pending changesets.
      </div>
    ) : (
      <ol class="space-y-3">
        {list.map((e) => (
          <li class="rounded-xl border border-border bg-card/30 p-4">
            <div class="flex flex-wrap items-start gap-3">
              <span class={`shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${bumpStyle[e.bump]}`}>{e.bump}</span>
              <div class="flex-1 min-w-0">
                <div class="font-semibold">{e.title}</div>
                <pre class="mt-2 whitespace-pre-wrap font-sans text-sm text-muted-foreground">{e.body}</pre>
                <div class="mt-2 font-mono text-[10px] text-muted-foreground/70">{e.id}</div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>
