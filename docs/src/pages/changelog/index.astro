---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/seo';
import entries from '../../content/changelog.json';

interface ChangelogItem {
  /** Cleaned body of the changelog bullet (without the `Thanks @user` prefix). */
  body: string;
  /** Pre-rendered HTML for `body` — produced at build time so the page
   *  doesn't ship a markdown parser to the browser. */
  bodyHtml?: string;
  /** Short commit SHA, when present in the changeset bullet. */
  commitSha?: string;
  commitUrl?: string;
  /** GitHub login of the changeset author. */
  author?: string;
}

interface ChangelogVersion {
  version: string;
  major: ChangelogItem[];
  minor: ChangelogItem[];
  patch: ChangelogItem[];
}

const list = (entries ?? []) as ChangelogVersion[];

const bumpStyle = {
  major: 'border-destructive/40 bg-destructive/10 text-destructive',
  minor: 'border-accent/40 bg-accent/10 text-accent',
  patch: 'border-primary/40 bg-primary/10 text-primary',
};

function bucketsFor(v: ChangelogVersion): { bump: 'major' | 'minor' | 'patch'; items: ChangelogItem[] }[] {
  return (
    [
      { bump: 'major' as const, items: v.major },
      { bump: 'minor' as const, items: v.minor },
      { bump: 'patch' as const, items: v.patch },
    ].filter((b) => b.items.length > 0)
  );
}
---
<Base title={`Changelog · ${SITE.name}`} description="Every released version of @schmooky/zvuk, sourced from the root CHANGELOG.md.">
  <div class="container py-12 max-w-4xl">
    <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">Releases</div>
    <h1 class="mb-3 text-4xl font-semibold tracking-tight">Changelog</h1>
    <p class="mb-8 text-lg text-muted-foreground max-w-2xl">
      Generated by <a href="https://github.com/changesets/changesets" class="text-foreground hover:text-primary underline-offset-4 hover:underline">Changesets</a>
      from <a href={`https://github.com/${SITE.github.split('/').slice(-2).join('/')}/blob/main/CHANGELOG.md`} class="text-foreground hover:text-primary underline-offset-4 hover:underline" target="_blank" rel="noopener">CHANGELOG.md</a>.
      Install any version with{' '}
      <code class="rounded bg-secondary/60 px-1 py-0.5 font-mono text-sm">pnpm add {SITE.npmName}@&lt;version&gt;</code>.
    </p>

    {list.length === 0 ? (
      <div class="rounded-xl border border-border bg-card/40 p-6 text-sm text-muted-foreground">
        No releases yet.
      </div>
    ) : (
      <ol class="space-y-8">
        {list.map((v) => (
          <li id={`v${v.version}`} class="rounded-xl border border-border bg-card/30 p-5 scroll-mt-20">
            <header class="mb-4 flex flex-wrap items-baseline justify-between gap-3 border-b border-border/40 pb-3">
              <h2 class="font-mono text-2xl font-semibold tracking-tight">
                <a href={`#v${v.version}`} class="hover:text-primary">v{v.version}</a>
              </h2>
              <a
                href={`https://github.com/${SITE.github.split('/').slice(-2).join('/')}/releases/tag/v${v.version}`}
                target="_blank"
                rel="noopener"
                class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground hover:text-primary"
              >
                GitHub release →
              </a>
            </header>
            {bucketsFor(v).map(({ bump, items }) => (
              <section class="mb-4 last:mb-0">
                <div class="mb-2 flex items-center gap-2">
                  <span class={`rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${bumpStyle[bump]}`}>{bump}</span>
                  <span class="text-xs text-muted-foreground">{items.length} change{items.length === 1 ? '' : 's'}</span>
                </div>
                <ul class="space-y-4 pl-2">
                  {items.map((item) => (
                    <li class="text-sm text-muted-foreground">
                      {item.bodyHtml ? (
                        <div class="changelog-prose" set:html={item.bodyHtml} />
                      ) : (
                        <p class="whitespace-pre-wrap">{item.body}</p>
                      )}
                      {(item.commitSha || item.author) && (
                        <div class="mt-1 flex flex-wrap gap-3 font-mono text-[10px] text-muted-foreground/70">
                          {item.commitSha && (
                            <a href={item.commitUrl} target="_blank" rel="noopener" class="hover:text-primary">{item.commitSha.slice(0, 7)}</a>
                          )}
                          {item.author && (
                            <a href={`https://github.com/${item.author}`} target="_blank" rel="noopener" class="hover:text-primary">@{item.author}</a>
                          )}
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </li>
        ))}
      </ol>
    )}
  </div>

  <style is:global>
    /* Prose styling for the rendered changelog markdown. Scoped to
       .changelog-prose so it doesn't leak into the rest of the site, and
       intentionally light — these blocks are short release notes, not
       articles, so we mostly just need readable spacing for paragraphs +
       lists + inline code + fenced blocks. */
    .changelog-prose {
      color: var(--color-foreground);
      line-height: 1.6;
    }
    .changelog-prose p {
      margin: 0.4em 0;
      color: hsl(var(--muted-foreground));
    }
    .changelog-prose p:first-child { margin-top: 0; }
    .changelog-prose p:last-child  { margin-bottom: 0; }
    .changelog-prose strong {
      color: var(--color-foreground);
      font-weight: 600;
    }
    .changelog-prose em { font-style: italic; }
    .changelog-prose ul,
    .changelog-prose ol {
      margin: 0.4em 0 0.4em 1.1em;
      padding: 0;
      color: hsl(var(--muted-foreground));
    }
    .changelog-prose li { margin: 0.2em 0; }
    .changelog-prose ul { list-style: disc; }
    .changelog-prose ol { list-style: decimal; }
    .changelog-prose a {
      color: hsl(var(--primary));
      text-underline-offset: 3px;
    }
    .changelog-prose a:hover { text-decoration: underline; }
    .changelog-prose code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.875em;
      padding: 0.1em 0.3em;
      border-radius: 0.25rem;
      background: hsl(var(--secondary) / 0.6);
      color: var(--color-foreground);
    }
    .changelog-prose pre {
      margin: 0.6em 0;
      padding: 0.85rem 1rem;
      border-radius: 0.5rem;
      background: hsl(var(--card) / 0.6);
      border: 1px solid hsl(var(--border));
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.8125rem;
      line-height: 1.5;
      overflow-x: auto;
      color: var(--color-foreground);
    }
    .changelog-prose pre code {
      padding: 0;
      background: transparent;
      border-radius: 0;
      font-size: inherit;
    }
    .changelog-prose h2,
    .changelog-prose h3,
    .changelog-prose h4 {
      color: var(--color-foreground);
      font-weight: 600;
      margin: 0.8em 0 0.3em;
      font-size: 0.95em;
    }
  </style>
</Base>
