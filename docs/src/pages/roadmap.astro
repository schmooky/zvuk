---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/seo';

interface Item {
  title: string;
  why: string;
  size?: 'S' | 'M' | 'L';
  link?: string;
}

// Headline change in v1.0.0 — every time-valued option in the public API
// now uses seconds, matching the Web Audio API. Listed first because it's a
// breaking change and the migration story matters.
const v1_0_0: Item[] = [
  {
    title: 'Normalize all time-valued options to seconds',
    why: 'Fades, crossfades, snapshot apply, Ducker/Sidechain attack/release — all in seconds now. Field renames: ms → duration, fadeMs → fade. Aligns with Web Audio (currentTime, AudioParam scheduling) and removes the *1000/÷1000 bug class. Breaking; migration table in CHANGELOG.',
    size: 'M',
    link: '/changelog/#v1.0.0',
  },
];

// Things shipped between v1.4 and v1.8. Roughly one feature per minor.
const recentMinors: Item[] = [
  { title: 'Snapshot blend (v1.12)', why: 'engine.blendSnapshots(a, b, t) snaps the mix to a linear interpolation between two captured snapshots. Wire it through a Parameter and you get continuous "calm ↔ combat" or "menu ↔ game" mix automation driven by one knob. The Wwise primitive the roadmap pointed at.', size: 'M', link: '/concepts/snapshot/' },
  { title: 'Music source — stinger → loop → outro (v1.8)', why: 'engine.loadMusic(name, { intro, loop, outro }) + MusicVoice.skipToOutro({ at: "loop-end" | "now" }). The pattern every casino slot, action game, and rhythm game uses for combat/win/menu music. Click-free at the loop boundary via loopCrossfade.', size: 'L', link: '/concepts/music/' },
  { title: 'voice.level() + bus.meter() — live amplitude readouts (v1.7)', why: 'Lazy AnalyserNode taps. Drove rhythm-metronome example, mixer dashboards, and the real "quietest" voice-stealing strategy.', size: 'M', link: '/concepts/bus/' },
  { title: 'engine.preload(items, { signal, concurrency, onProgress }) (v1.6)', why: 'First-class bulk loader for loading screens. Per-item progress, concurrency cap, aggregated PreloadError.', size: 'M', link: '/guides/loading/#first-class-preloader-engine-preload' },
  { title: 'loopCrossfade play option (v1.5)', why: 'Off-by-default equal-power crossfade at the loop boundary so non-zero-crossing music regions don\'t click.', size: 'M', link: '/concepts/voice/#loop-crossfade-off-by-default' },
  { title: 'Audit cleanups (v1.4)', why: 'Real Filter bypass, dead BankNotLoadedError removed, honest \'quietest\' fallback warning until per-voice metering shipped in v1.7.', size: 'S' },
  { title: 'createEngine({ resolveAsset }) hook (v1.3)', why: 'Adopt buffers from Pixi Assets.cache, IndexedDB, or any external asset system without zvuk depending on it.', size: 'M', link: '/guides/asset-resolution/' },
  { title: 'tickSource injection + autoPauseOnHidden (v1.2)', why: 'Wire the scheduler into a host\'s render loop (Pixi/GSAP) instead of setTimeout, and opt out of visibility-pause for music players.', size: 'M', link: '/guides/runtime-timing/' },
  { title: 'Click-free voice.stop() (v1.1)', why: 'Tiny gain ramp before source.stop() suppresses the click that fires when buffers are cut mid-waveform.', size: 'S' },
];

// Everything from the public roadmap that v0.0.2 shipped. These render in
// the "Recently shipped" section so the page reflects current state instead
// of pretending the work is still pending.
const recentlyShipped: Item[] = [
  { title: 'Live spatializer control on Voice', why: 'voice.spatializer.setPan / setPosition during playback.', size: 'S', link: '/concepts/spatializer/' },
  { title: 'Voice pause / resume', why: 'voice.pause() / resume() with offset retention.', size: 'S', link: '/concepts/voice/' },
  { title: 'Live voice.playbackRate setter', why: 'voice.setPlaybackRate(rate, { duration, curve }) with optional ramp.', size: 'S', link: '/concepts/voice/' },
  { title: 'Audio sprites', why: 'engine.loadSprite(name, url, regions) → engine.sprite(name).play(region).', size: 'M' },
  { title: 'Stream source', why: 'engine.loadStream(name, url) — HTMLAudioElement + MediaElementAudioSource for long media.', size: 'M' },
  { title: 'Loudness normalization on load', why: 'loadSound(..., { normalize: true }) — RMS target with peak ceiling.', size: 'M' },
  { title: 'Better error messages', why: 'BusNotFoundError("sxf"; did you mean "sfx").', size: 'S', link: '/concepts/engine/' },
  { title: 'Realtime stretch via AudioWorklet', why: 'ensureStretchWorklet(ctx) + createStretchWorkletNode(ctx) with live `stretch` AudioParam.', size: 'L', link: '/fx/pitch/' },
  { title: 'Master limiter', why: 'master.limiter config wires a fast-attack DynamicsCompressor on master out.', size: 'S', link: '/concepts/mixer/' },
  { title: 'Crossfade helper', why: 'engine.crossfade(from, to, { duration, curve }) — equal-power by default.', size: 'S' },
  { title: 'Examples directory', why: 'Vanilla deployable apps under /examples/ (slot-machine, match-3, fps-footsteps).', size: 'L' },
  { title: 'npx zvuk transcode', why: 'ffmpeg ladder (webm/opus + m4a/aac) packaged as a CLI.', size: 'S', link: '/guides/asset-formats/' },
  { title: 'npx zvuk gen bank.json', why: 'Typed sound-name module emitted from a manifest.', size: 'M' },
  { title: 'Bench suite', why: 'vitest bench/ for voice spawn, decode + cache, fade drift.', size: 'M' },
  { title: 'Auto-generated /api/ from TypeDoc', why: 'TypeDoc JSON → Astro pages, regenerated each build.', size: 'M' },
  { title: 'Pagefind search', why: '⌘K modal indexed at build time.', size: 'S' },
  { title: 'Auto changelog page', why: '/changelog/ built from .changeset/*.md.', size: 'S' },
  { title: 'OG images', why: 'Per-page social cards via astro-og-canvas.', size: 'S' },
];

// What's still on the table. Each line is roughly one minor release of work.
const tier1: Item[] = [
  {
    title: 'Bus sends / aux',
    why: 'bus.send(target, { amount }) so you can route 30% of music through a verb-only bus instead of inserting reverb directly. The Wwise primitive the README claims and the API doesn\'t yet have.',
    size: 'M',
    link: '/concepts/bus/',
  },
  {
    title: 'Solo + busGroup',
    why: 'bus.solo() (mute everyone else), engine.busGroup(name, [...buses]) so snapshots and parameters can address logical groups instead of repeating bus names.',
    size: 'S',
  },
  {
    title: 'engine.masterMeter()',
    why: 'Live RMS + peak on the master output. Same primitive as bus.meter() / voice.level(), just exposed at the top of the chain.',
    size: 'S',
  },
];

const tier2: Item[] = [
  {
    title: 'Spatializer 3D config',
    why: 'Expose refDistance / maxDistance / rolloffFactor on Spatializer (currently hard-coded), plus a single-knob distance Parameter that drives attenuation + a low-pass for occlusion.',
    size: 'M',
    link: '/concepts/spatializer/',
  },
  {
    title: 'Variants helper',
    why: 'engine.loadVariants("coin", urls) + engine.variants("coin").play() picks one randomly. Slot games play random coin/win/reel-stop variants constantly — currently nightmare-ergonomic without this.',
    size: 'S',
  },
  {
    title: 'play({ fadeIn })',
    why: 'Convenience for "drop into the menu" intros. Currently requires play({ volume: 0 }) + fade() — trivially the dual of the existing stop fade.',
    size: 'S',
    link: '/concepts/voice/',
  },
  {
    title: 'engine.unloadSound(name, { evictBuffer: true })',
    why: 'Currently removeSound() drops the registry entry but the buffer stays in the LRU. Hot-swappable themes (kiosks, slot lobbies) need explicit eviction.',
    size: 'S',
  },
];

const tier3: Item[] = [
  {
    title: 'Branded BusName / SoundName types',
    why: 'engine.bus(name) and engine.sound(name) currently take any string. Inferring from createEngine({ buses: { ... } }) gives compile-time correctness on typos.',
    size: 'M',
  },
  {
    title: 'createEngine({ latencyHint })',
    why: 'Maps to AudioContext.latencyHint. Slot games doing 60 fps reactive audio want \'interactive\'; long music players want \'playback\'. Currently we accept the default.',
    size: 'S',
  },
  {
    title: 'Per-voice FX',
    why: 'FX inserts are bus-level today. No way to put a flanger on one voice without dedicating a bus to it.',
    size: 'L',
  },
];

const tier4: Item[] = [
  {
    title: 'engine.recordOutput()',
    why: 'Capture the master to a Blob via MediaStreamDestination. Casino "show-mode" replays — niche but specific.',
    size: 'M',
  },
  {
    title: 'Android focus / interruption tracking',
    why: 'iOS \'interrupted\' state is handled. Android focus loss is similar and we currently lean on visibilitychange only.',
    size: 'M',
  },
];

const sizeBadge = {
  S: { label: 'small', cls: 'border-primary/40 bg-primary/10 text-primary' },
  M: { label: 'medium', cls: 'border-accent/40 bg-accent/10 text-accent' },
  L: { label: 'large',  cls: 'border-destructive/40 bg-destructive/10 text-destructive' },
};

const sections = [
  { tier: 1, title: 'Highest impact', subtitle: "Hit immediately, missing today, small surface.", items: tier1 },
  { tier: 2, title: 'Quality of life', subtitle: 'Pays back forever — across every page, every adopter.', items: tier2 },
  { tier: 3, title: 'For "library people adopt"', subtitle: 'Not just "library that works."', items: tier3 },
  { tier: 4, title: 'Polish', subtitle: 'Can wait, but on the list.', items: tier4 },
].filter((s) => s.items.length > 0);
---
<Base title={`Roadmap · ${SITE.name}`} description="What's next in zvuk — public, prioritised, sized.">
  <div class="container py-12 max-w-4xl">
    <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">Public roadmap</div>
    <h1 class="mb-3 text-4xl font-semibold tracking-tight">What's next</h1>
    <p class="mb-8 text-lg text-muted-foreground max-w-2xl">
      An honest punch list of what would make zvuk better, ordered by impact.
      No promises on dates — this is intent, not a release schedule. PRs welcome
      on anything sized <span class="inline-block rounded border border-primary/40 bg-primary/10 px-1.5 py-0.5 font-mono text-[10px] text-primary">small</span>.
    </p>

    <div class="mb-10 rounded-xl border border-border bg-card/40 p-5">
      <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">Status</div>
      <div class="grid gap-3 text-sm sm:grid-cols-2">
        <div>
          <div class="font-semibold">Shipped in v{SITE.version}</div>
          <div class="text-muted-foreground">Runtime + lazy AudioContext, mixer + buses + click-free fades, FX chain (compressor / filter / reverb / ducker / pitch-preserving stretch), spatializer (2D + 3D), parameters, snapshots, concurrency policies, codec ladder, voice jitter, scheduler.</div>
        </div>
        <div>
          <div class="font-semibold">Not on this roadmap</div>
          <div class="text-muted-foreground">Framework adapters (React/Vue/Svelte). Visual node-graph editor. WASM DSP. Native bridge for React Native or Electron-specific paths. HRTF spatializer beyond stock PannerNode HRTF. These remain out-of-scope for the foreseeable.</div>
        </div>
      </div>
    </div>

    <section class="mb-12">
      <div class="mb-1 flex items-baseline gap-3">
        <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">v1.4 → v1.8</div>
        <h2 class="text-2xl font-semibold tracking-tight">Recently shipped</h2>
      </div>
      <p class="mb-5 text-sm text-muted-foreground">Roughly one feature per minor release. Most recent first.</p>
      <ol class="space-y-3">
        {recentMinors.map((item) => {
          const badge = sizeBadge[item.size ?? 'M'];
          return (
            <li class="rounded-xl border border-primary/30 bg-primary/[0.04] p-4">
              <div class="flex flex-wrap items-start gap-3">
                <div class="flex-1 min-w-0">
                  <div class="font-semibold">
                    <span class="mr-2 inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary/30 text-[10px] text-primary-foreground">✓</span>
                    {item.title}
                  </div>
                  <p class="mt-1 text-sm text-muted-foreground">{item.why}</p>
                  {item.link && (
                    <a href={item.link} class="mt-2 inline-flex items-center gap-1 font-mono text-[11px] text-primary hover:underline">
                      related: {item.link}
                    </a>
                  )}
                </div>
                <span class={`shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${badge.cls}`}>{badge.label}</span>
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="mb-12">
      <div class="mb-1 flex items-baseline gap-3">
        <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">v1.0.0</div>
        <h2 class="text-2xl font-semibold tracking-tight">First stable release</h2>
      </div>
      <p class="mb-5 text-sm text-muted-foreground">The headline change was a unit normalization across the public API.</p>
      <ol class="space-y-3">
        {v1_0_0.map((item) => {
          const badge = sizeBadge[item.size ?? 'M'];
          return (
            <li class="rounded-xl border border-primary/30 bg-primary/[0.04] p-4">
              <div class="flex flex-wrap items-start gap-3">
                <div class="flex-1 min-w-0">
                  <div class="font-semibold">
                    <span class="mr-2 inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary/30 text-[10px] text-primary-foreground">✓</span>
                    {item.title}
                  </div>
                  <p class="mt-1 text-sm text-muted-foreground">{item.why}</p>
                  {item.link && (
                    <a href={item.link} class="mt-2 inline-flex items-center gap-1 font-mono text-[11px] text-primary hover:underline">
                      related: {item.link}
                    </a>
                  )}
                </div>
                <span class={`shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${badge.cls}`}>{badge.label}</span>
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="mb-12">
      <div class="mb-1 flex items-baseline gap-3">
        <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">v0.0.2</div>
        <h2 class="text-2xl font-semibold tracking-tight">Earlier — roadmap tier sweep</h2>
      </div>
      <p class="mb-5 text-sm text-muted-foreground">A roadmap-tier sweep — every actionable item from Tiers 1–4, end-to-end. Framework adapters remain out of scope.</p>
      <ol class="space-y-3">
        {recentlyShipped.map((item) => {
          const badge = sizeBadge[item.size ?? 'M'];
          return (
            <li class="rounded-xl border border-primary/30 bg-primary/[0.04] p-4">
              <div class="flex flex-wrap items-start gap-3">
                <div class="flex-1 min-w-0">
                  <div class="font-semibold">
                    <span class="mr-2 inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary/30 text-[10px] text-primary-foreground">✓</span>
                    {item.title}
                  </div>
                  <p class="mt-1 text-sm text-muted-foreground">{item.why}</p>
                  {item.link && (
                    <a href={item.link} class="mt-2 inline-flex items-center gap-1 font-mono text-[11px] text-primary hover:underline">
                      related: {item.link}
                    </a>
                  )}
                </div>
                <span class={`shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${badge.cls}`}>{badge.label}</span>
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    {sections.map(({ tier, title, subtitle, items }) => (
      <section class="mb-12">
        <div class="mb-1 flex items-baseline gap-3">
          <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">Tier {tier}</div>
          <h2 class="text-2xl font-semibold tracking-tight">{title}</h2>
        </div>
        <p class="mb-5 text-sm text-muted-foreground">{subtitle}</p>

        <ol class="space-y-3">
          {items.map((item) => {
            const badge = sizeBadge[item.size ?? 'M'];
            return (
              <li class="rounded-xl border border-border bg-card/30 p-4 transition-colors hover:border-primary/40 hover:bg-card/50">
                <div class="flex flex-wrap items-start gap-3">
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold">{item.title}</div>
                    <p class="mt-1 text-sm text-muted-foreground">{item.why}</p>
                    {item.link && (
                      <a
                        href={item.link}
                        class="mt-2 inline-flex items-center gap-1 font-mono text-[11px] text-primary hover:underline"
                      >
                        related: {item.link}
                      </a>
                    )}
                  </div>
                  <span class={`shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${badge.cls}`}>
                    {badge.label}
                  </span>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <div class="mt-16 rounded-xl border border-primary/30 bg-primary/[0.04] p-6">
      <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-primary mb-2">Contribute</div>
      <h3 class="text-lg font-semibold mb-2">Pick one and PR it</h3>
      <p class="text-sm text-muted-foreground mb-3">
        Items sized <span class="font-mono text-primary">small</span> are usually a single
        file plus a test. Items sized <span class="font-mono text-accent">medium</span> typically touch
        2–4 files. Items sized <span class="font-mono text-destructive">large</span> are worth
        opening an issue first to align on shape.
      </p>
      <a
        href={`${SITE.github}/issues/new`}
        target="_blank"
        rel="noopener"
        class="inline-flex h-9 items-center justify-center rounded-md border border-primary/40 bg-primary/10 px-4 text-sm font-medium text-primary hover:bg-primary/20"
      >
        Open an issue
      </a>
    </div>
  </div>
</Base>
