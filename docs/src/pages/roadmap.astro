---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/seo';

interface Item {
  title: string;
  why: string;
  size?: 'S' | 'M' | 'L';
  link?: string;
}

const tier1: Item[] = [
  {
    title: 'Live spatializer control on Voice',
    why: 'voice.spatializer.setPan / setPosition while playing. Today the option is set at spawn and frozen — moving sources need a re-attach. The SpatialPanner demo even has to fake it.',
    size: 'S',
    link: '/concepts/spatializer/',
  },
  {
    title: 'Voice pause / resume',
    why: 'pause-on-menu, pause-on-blur, per-voice. Track the offset; resume from where it stopped. Currently we only have stop().',
    size: 'S',
    link: '/concepts/voice/',
  },
  {
    title: 'Live voice.playbackRate setter',
    why: 'pitch is set in PlayOptions and frozen. Live ramps unlock tension/slow-mo without granular stretch.',
    size: 'S',
    link: '/concepts/voice/',
  },
  {
    title: 'Audio sprites',
    why: 'one buffer, many named regions, one fetch. Match-3 cascades, UI variants, low-latency one-shots. ~80 lines.',
    size: 'M',
  },
  {
    title: 'Stream source',
    why: '<audio> + MediaElementAudioSource for music files >30s. Don\'t decode 4-minute tracks into RAM. iOS works around its own decode bugs this way.',
    size: 'M',
  },
];

const tier2: Item[] = [
  {
    title: 'Auto-generated /api/ from TypeDoc',
    why: 'Concept pages have hand-written API blocks; that drifts. TypeDoc → JSON → custom Astro content loader → MDX pages with consistent shape. Reference is always current.',
    size: 'M',
  },
  {
    title: 'Pagefind search',
    why: '⌘K modal in the nav, indexed at build time, no Algolia key. With 27+ pages, search starts mattering.',
    size: 'S',
  },
  {
    title: 'Loudness normalization on load',
    why: 'loadSound(..., { normalize: true }) runs an RMS pass at decode and applies makeup gain so all sounds sit at the same perceived loudness. Removes a workflow tax every game-audio team currently pays in their DAW.',
    size: 'M',
  },
  {
    title: 'Better error messages',
    why: 'BusNotFoundError("sxf"; did you mean "sfx"?). Levenshtein on declared bus/sound names. Single-file change, big DX feel.',
    size: 'S',
    link: '/concepts/engine/',
  },
  {
    title: 'Realtime stretch via AudioWorklet',
    why: 'Current StretchProcessor is offline-only. Worklet port unlocks live tempo modulation — boss intros that bend in real time.',
    size: 'L',
    link: '/fx/pitch/',
  },
];

const tier3: Item[] = [
  {
    title: 'Master limiter',
    why: 'Headroom is a static gain; a brick-wall limiter on master prevents clipping when FX stack. DynamicsCompressorNode at ratio 20+, fast attack.',
    size: 'S',
    link: '/concepts/mixer/',
  },
  {
    title: 'Crossfade helper',
    why: 'engine.crossfade("intro", "main", { ms: 1500 }) — common music-swap pattern. People will write this themselves five times before realising it should be a helper.',
    size: 'S',
  },
  {
    title: 'Examples directory',
    why: 'Full deployable apps in /examples/: slot-machine, match-3, fps-footsteps. Way more convincing than 11 isolated demos. Linked from the landing.',
    size: 'L',
  },
];

const tier4: Item[] = [
  { title: 'npx zvuk transcode raw/*.wav', why: 'The ffmpeg loop from the asset-formats guide as a CLI. Cuts setup friction.', size: 'S', link: '/guides/asset-formats/' },
  { title: 'npx zvuk gen bank.json',        why: 'Typed sound names emitted from a manifest, so engine.sound("coin") is autocompleted.', size: 'M' },
  { title: 'Bench suite',                   why: 'Voice spawn rate, decode time, fade event drift. Wired to PR CI.', size: 'M' },
  { title: 'Touch handling polish',         why: 'SpatialPanner is mouse-first; touch drag is rough on mobile.', size: 'S', link: '/concepts/spatializer/' },
  { title: 'Auto changelog page',           why: 'Render .changeset/*.md as /changelog/ at build time.', size: 'S' },
  { title: 'OG images',                     why: 'Per-page social cards via astro-og-canvas.', size: 'S' },
];

const sizeBadge = {
  S: { label: 'small', cls: 'border-primary/40 bg-primary/10 text-primary' },
  M: { label: 'medium', cls: 'border-accent/40 bg-accent/10 text-accent' },
  L: { label: 'large',  cls: 'border-destructive/40 bg-destructive/10 text-destructive' },
};

const sections = [
  { tier: 1, title: 'Highest impact', subtitle: "Hit immediately, missing today, small surface.", items: tier1 },
  { tier: 2, title: 'Quality of life', subtitle: 'Pays back forever — across every page, every adopter.', items: tier2 },
  { tier: 3, title: 'For "library people adopt"', subtitle: 'Not just "library that works."', items: tier3 },
  { tier: 4, title: 'Polish', subtitle: 'Can wait, but on the list.', items: tier4 },
];
---
<Base title={`Roadmap · ${SITE.name}`} description="What's next in zvuk — public, prioritised, sized.">
  <div class="container py-12 max-w-4xl">
    <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">Public roadmap</div>
    <h1 class="mb-3 text-4xl font-semibold tracking-tight">What's next</h1>
    <p class="mb-8 text-lg text-muted-foreground max-w-2xl">
      An honest punch list of what would make zvuk better, ordered by impact.
      No promises on dates — this is intent, not a release schedule. PRs welcome
      on anything sized <span class="inline-block rounded border border-primary/40 bg-primary/10 px-1.5 py-0.5 font-mono text-[10px] text-primary">small</span>.
    </p>

    <div class="mb-10 rounded-xl border border-border bg-card/40 p-5">
      <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">Status</div>
      <div class="grid gap-3 text-sm sm:grid-cols-2">
        <div>
          <div class="font-semibold">Shipped in v0.0.1</div>
          <div class="text-muted-foreground">Runtime + lazy AudioContext, mixer + buses + click-free fades, FX chain (compressor / filter / reverb / ducker / pitch-preserving stretch), spatializer (2D + 3D), parameters, snapshots, concurrency policies, codec ladder, voice jitter, scheduler.</div>
        </div>
        <div>
          <div class="font-semibold">Not on this roadmap</div>
          <div class="text-muted-foreground">Framework adapters (React/Vue/Svelte). Visual node-graph editor. WASM DSP. Native bridge for React Native or Electron-specific paths. HRTF spatializer beyond stock PannerNode HRTF. These remain out-of-scope for the foreseeable.</div>
        </div>
      </div>
    </div>

    {sections.map(({ tier, title, subtitle, items }) => (
      <section class="mb-12">
        <div class="mb-1 flex items-baseline gap-3">
          <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">Tier {tier}</div>
          <h2 class="text-2xl font-semibold tracking-tight">{title}</h2>
        </div>
        <p class="mb-5 text-sm text-muted-foreground">{subtitle}</p>

        <ol class="space-y-3">
          {items.map((item) => {
            const badge = sizeBadge[item.size ?? 'M'];
            return (
              <li class="rounded-xl border border-border bg-card/30 p-4 transition-colors hover:border-primary/40 hover:bg-card/50">
                <div class="flex flex-wrap items-start gap-3">
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold">{item.title}</div>
                    <p class="mt-1 text-sm text-muted-foreground">{item.why}</p>
                    {item.link && (
                      <a
                        href={item.link}
                        class="mt-2 inline-flex items-center gap-1 font-mono text-[11px] text-primary hover:underline"
                      >
                        related: {item.link}
                      </a>
                    )}
                  </div>
                  <span class={`shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${badge.cls}`}>
                    {badge.label}
                  </span>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <div class="mt-16 rounded-xl border border-primary/30 bg-primary/[0.04] p-6">
      <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-primary mb-2">Contribute</div>
      <h3 class="text-lg font-semibold mb-2">Pick one and PR it</h3>
      <p class="text-sm text-muted-foreground mb-3">
        Items sized <span class="font-mono text-primary">small</span> are usually a single
        file plus a test. Items sized <span class="font-mono text-accent">medium</span> typically touch
        2–4 files. Items sized <span class="font-mono text-destructive">large</span> are worth
        opening an issue first to align on shape.
      </p>
      <a
        href={`${SITE.github}/issues/new`}
        target="_blank"
        rel="noopener"
        class="inline-flex h-9 items-center justify-center rounded-md border border-primary/40 bg-primary/10 px-4 text-sm font-medium text-primary hover:bg-primary/20"
      >
        Open an issue
      </a>
    </div>
  </div>
</Base>
