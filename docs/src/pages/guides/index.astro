---
import CardGrid from '../../components/CardGrid.astro';
import Docs from '../../layouts/Docs.astro';

const guides = [
  { slug: 'asset-formats', label: 'Asset formats',     blurb: 'WebM/Opus + M4A/AAC, the why and the ffmpeg.' },
  { slug: 'loading',       label: 'Loading sounds',    blurb: 'Single, bulk, progress, AbortSignal.' },
  { slug: 'asset-resolution', label: 'Asset resolution', blurb: 'Hand zvuk buffers from Pixi Assets, IndexedDB or your own cache.' },
  { slug: 'mix',           label: 'Building your mix', blurb: 'Pick the buses. Declare them. Route everything.' },
  { slug: 'ducking',       label: 'Sidechain ducking', blurb: 'Drop the music when the VO speaks.' },
  { slug: 'runtime-timing', label: 'Runtime timing',   blurb: 'Audio clock versus JS clock, and which ticker drives dispatch.' },
  { slug: 'errors',        label: 'Errors',            blurb: 'Which call throws which error class, and what to do about it.' },
  { slug: 'migrating-to-v2', label: 'Migrating to v2', blurb: 'The breaking changes in 2.0.0, what to do about each, and what is new.' },
  { slug: 'migration',     label: 'Migrating from Howler', blurb: 'API mapping + step-by-step port.' },
];
---
<Docs
  title="Guides"
  description="Practical walkthroughs that reach across multiple concepts."
  eyebrow="Guides"
>
  <CardGrid cards={guides.map((c) => ({ href: `/guides/${c.slug}/`, title: c.label, body: c.blurb }))} />
</Docs>
