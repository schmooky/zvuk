---
import VariantSpam from '../../components/demos/VariantSpam.tsx';
import Since from '../../components/Since.astro';
import Snippet from '../../components/Snippet.astro';
import Docs from '../../layouts/Docs.astro';

const single = `await engine.loadSound('coin', '/sfx/coin.webm', { bus: 'sfx' });`;

const ladder = `await engine.loadSound('coin', [
  '/sfx/coin.webm',
  '/sfx/coin.m4a',
], { bus: 'sfx' });`;

const bulk = `const manifest = [
  { name: 'coin',     urls: ['/sfx/coin.webm', '/sfx/coin.m4a'],     bus: 'sfx' },
  { name: 'win',      urls: ['/sfx/win.webm', '/sfx/win.m4a'],       bus: 'sfx' },
  { name: 'reel',     urls: ['/sfx/reel.webm', '/sfx/reel.m4a'],     bus: 'sfx' },
  { name: 'bg-music', urls: ['/music/bg.webm', '/music/bg.m4a'],     bus: 'music' },
];

await Promise.all(
  manifest.map(({ name, urls, bus }) =>
    engine.loadSound(name, urls, { bus }),
  ),
);`;

const progress = `let loaded = 0;
const total = manifest.length;

await Promise.all(
  manifest.map(async (entry) => {
    await engine.loadSound(entry.name, entry.urls, { bus: entry.bus });
    loaded++;
    onProgress(loaded / total);   // 0..1
  }),
);`;

const preload = `// engine.preload(items) — bulk-load with progress + concurrency cap.
await engine.preload(
  [
    { name: 'coin', url: ['/sfx/coin.webm', '/sfx/coin.m4a'], options: { bus: 'sfx' } },
    { name: 'win',  url: ['/sfx/win.webm',  '/sfx/win.m4a'],  options: { bus: 'sfx' } },
    { name: 'reel', url: ['/sfx/reel.webm', '/sfx/reel.m4a'], options: { bus: 'sfx' } },
    // ... 100 more items
  ],
  {
    concurrency: 4,                    // default — caps in-flight fetches
    onProgress: ({ name, status, completed, total }) => {
      bar.value = completed / total;
      if (status === 'failed') log.warn(\`\${name} failed\`);
    },
  },
);

// On failure: PreloadError with .failures: { name, cause }[]
// — the rest of the batch still completes; broken assets don't short-circuit
// the loading screen.`;

const preloadCancel = `// Cancellable preload — same shape as loadSound's signal.
const ac = new AbortController();
button.addEventListener('click', () => ac.abort());
try {
  await engine.preload(items, { signal: ac.signal });
} catch (e) {
  if ((e as Error).name === 'AbortError') console.log('user cancelled');
  else throw e;
}`;

const cancel = `const ac = new AbortController();
try {
  await Promise.all(
    manifest.map((m) => engine.loadSound(m.name, m.urls, { bus: m.bus, signal: ac.signal })),
  );
} catch (e) {
  if ((e as Error).name === 'AbortError') console.log('cancelled');
  else throw e;
}

// On route change:
ac.abort();`;

const bytes = `// One big file: a smooth bar from byte progress.
await engine.loadSound('theme', ['/music/theme.webm', '/music/theme.m4a'], {
  bus: 'music',
  onProgress: (loaded, total) => {
    bar.value = total ? loaded / total : 0; // total is null without Content-Length
  },
});

// A batch with a few large files: per-item bytes alongside per-item completion.
const seen = new Map<string, number>();
await engine.preload(manifest, {
  onProgress: ({ completed, total }) => { label.textContent = completed + ' / ' + total; },
  onBytes: ({ name, loadedBytes }) => {
    seen.set(name, loadedBytes);
    bytesLabel.textContent = ([...seen.values()].reduce((a, b) => a + b, 0) / 1e6).toFixed(1) + ' MB';
  },
});`;

const kinds = `await engine.preload([
  { name: 'coin', url: ['/sfx/coin.webm', '/sfx/coin.m4a'], options: { bus: 'sfx' } },
  {
    kind: 'sprite',
    name: 'ui',
    url: ['/sfx/ui.webm', '/sfx/ui.m4a'],
    regions: { click: { start: 0, duration: 0.05 }, open: { start: 0.1, duration: 0.4 } },
    options: { bus: 'ui' },
  },
  {
    kind: 'variants',
    name: 'roll',
    urls: [['/sfx/roll-1.webm', '/sfx/roll-1.m4a'], ['/sfx/roll-2.webm', '/sfx/roll-2.m4a']],
    options: { bus: 'sfx', strategy: 'shuffle-bag', weights: [2, 1] },
  },
  {
    kind: 'music',
    name: 'bonus',
    parts: { intro: '/music/bonus-intro.webm', loop: '/music/bonus-loop.webm' },
    options: { bus: 'music', bpm: 128 },
  },
], { concurrency: 4, onProgress });`;

const weights = `// The plain take three times as often as each rare one; weight 0 never plays.
await engine.loadVariants('coin', takes, { bus: 'sfx', weights: [3, 1, 1, 0] });

// Retune later (null resets to equal weights).
engine.variants('coin').setWeights([1, 1, 1, 1]);`;

const stream = `// Long media — use loadStream so a 4-minute mix doesn't decode into RAM.
const intro = engine.loadStream('intro', '/music/intro.m4a', { bus: 'music' });
await intro.play({ loop: true, volume: 0.6 });
intro.fade({ to: 0, duration: 1.5 });`;

const sprite = `// Sprite — share one buffer across N regions.
await engine.loadSprite('reel', '/sfx/reel.webm', {
  tick:      { start: 0,    duration: 0.06 },
  stop:      { start: 0.1,  duration: 0.18 },
  'win-sting': { start: 0.5, duration: 1.2 },
}, { bus: 'sfx' });`;

const variants = `// Variants — N alternate one-shots; spam picks one each play() so
// stacked SFX don't sound robotic.
await engine.loadVariants(
  'coin',
  [
    ['/sfx/coin-1.webm', '/sfx/coin-1.m4a'],
    ['/sfx/coin-2.webm', '/sfx/coin-2.m4a'],
    ['/sfx/coin-3.webm', '/sfx/coin-3.m4a'],
  ],
  { bus: 'sfx', strategy: 'no-repeat' },     // 'random' | 'no-repeat' | 'shuffle-bag'
);

engine.variants('coin').play();
engine.variants('coin').play({ pitch: { jitter: 0.04 } });`;

const unload = `// Drop a sound from the registry AND evict its buffer from the LRU.
engine.unloadSound('coin');                  // default: evictBuffer: true
engine.unloadSound('coin', { evictBuffer: false }); // registry only

// Active voices keep playing until they end naturally — only future
// play() calls are affected. Use this for hot-swappable themes
// (kiosks, slot lobbies).`;

const normalize = `// Normalize on load — uniform perceived loudness without re-mastering.
await engine.loadSound('crowd', '/sfx/crowd.webm', {
  bus: 'sfx',
  normalize: true,
});`;

const banks = `// CLI: zvuk gen bank.json → bank.gen.ts (typed loader).
import { loadBank } from './bank.gen';
await loadBank(engine);`;
---
<Docs
  title="Loading sounds"
  description="The patterns for getting audio off the network and into the engine. Single, bulk, with progress, with cancellation."
  eyebrow="Guide"
>

  <h2>Single sound</h2>
  <Snippet code={single} lang="ts" />

  <h2>Codec ladder</h2>
  <p>
    Pass an array; the engine picks the first URL the browser can decode.
    See the <a href="/guides/asset-formats/">asset-formats guide</a> for the
    encoding pipeline.
  </p>
  <Snippet code={ladder} lang="ts" />

  <h2>Bulk load with Promise.all</h2>
  <p>
    The <code>Decoder</code> is concurrent-safe; firing N requests in parallel
    is the right move. Network is almost always the bottleneck, not decoding.
  </p>
  <Snippet code={bulk} lang="ts" />

  <h2>Progress reporting</h2>
  <p>
    The DIY pattern with <code>Promise.all</code> works for small batches.
  </p>
  <Snippet code={progress} lang="ts" />

  <h2>
    First-class preloader: <code>engine.preload</code> <Since v="1.6" />
  </h2>
  <p>
    For a loading screen with a fixed manifest, <code>engine.preload</code>
    handles the boilerplate. It reports per-item progress, caps concurrency so
    the rest of the page's network isn't starved, and aggregates failures
    rather than short-circuiting on the first broken asset. Items match the
    <code>loadSound</code> shape one for one.
  </p>
  <Snippet code={preload} lang="ts" />

  <h2>Byte progress <Since v="2.0" /></h2>
  <p>
    Item counts make a bar that jumps when one file is ten times the size of
    the others. <code>LoadSoundOptions.onProgress(loadedBytes, totalBytes)</code>
    reports bytes as chunks arrive, and <code>PreloadOptions.onBytes</code>
    does the same per item in a batch. Neither fires for cache hits or for a
    buffer a <code>resolveAsset</code> hook hands back, and when two loads
    share one download only the first gets bytes.
  </p>
  <Snippet code={bytes} lang="ts" />

  <h2>Preload any kind <Since v="2.0" /></h2>
  <p>
    A preload item without <code>kind</code> is a sound, as before. With
    <code>kind: 'sprite'</code>, <code>'variants'</code> or
    <code>'music'</code> it takes that loader's arguments
    (<code>PreloadSpriteItem</code>, <code>PreloadVariantsItem</code>,
    <code>PreloadMusicItem</code>), so one loading screen covers a whole
    scene.
  </p>
  <Snippet code={kinds} lang="ts" />

  <h2>Cancelling a preload</h2>
  <p>
    Pass an <code>AbortSignal</code> in <code>options</code>. The same
    convention as a single <code>loadSound</code> call. Pending items are
    never started and in-flight fetches receive the abort.
  </p>
  <Snippet code={preloadCancel} lang="ts" />

  <h2>Cancellable single loads</h2>
  <p>
    Pass an <code>AbortSignal</code>. The fetch is cancelled mid-flight; in-progress
    decodes complete (Web Audio's <code>decodeAudioData</code> is not abortable).
  </p>
  <Snippet code={cancel} lang="ts" />

  <h2>Long media: stream, don't decode</h2>
  <p>
    For tracks longer than ~30 seconds, use <code>loadStream</code> instead of
    <code>loadSound</code>. The asset is read off disk progressively through an
    internal <code>HTMLAudioElement</code> + <code>MediaElementAudioSource</code>,
    so RAM stays flat and iOS Safari stops choking.
  </p>
  <Snippet code={stream} lang="ts" />

  <h2>Sprites: bundle short SFX</h2>
  <p>
    For UI variants and cascade SFX that share a session, a single buffer with
    named regions is faster to load and lower-overhead per voice than N
    separate <code>loadSound</code> calls.
  </p>
  <Snippet code={sprite} lang="ts" />

  <h2>Variants: randomise stacked SFX <Since v="1.11" /></h2>
  <p>
    Slot games play coin/win/reel-stop variants on every interaction. A
    pure random picker can play the same one twice in a row, which sounds
    robotic. <code>engine.loadVariants</code> bundles N alternates and
    picks one per <code>play()</code> using a configurable strategy.
    <code>'random'</code> is uniform. <code>'no-repeat'</code>, the default,
    never picks the same one twice running. <code>'shuffle-bag'</code> cycles
    through every variant before reshuffling, the way Tetris deals pieces.
  </p>
  <Snippet code={variants} lang="ts" />
  <p>
    Four takes of one dice roll, below. Set the strategy to
    <code>'random'</code> and mash the button: the same take comes up twice
    in a row often enough to sound like a bug, and the history marks each
    repeat in red. <code>'no-repeat'</code> makes that impossible.
    <code>engine.variants(name).lastPick</code> is where the history comes
    from, and it is also how you drive a subtitle or a telemetry event off
    whichever take actually fired.
  </p>
  <VariantSpam client:visible />

  <h3>Weighted takes <Since v="2.0" /></h3>
  <p>
    <code>weights</code> on <code>loadVariants</code> (or
    <code>variants.setWeights()</code>) makes some takes commoner than
    others. Missing entries count as 1 and a weight of 0 never plays, unless
    every weight is 0. <code>'no-repeat'</code> still never repeats, and
    <code>'shuffle-bag'</code> puts <code>round(weight)</code> copies of each
    take in the bag. Since v2 <code>'no-repeat'</code> can also pick the
    first take on the first play, which 1.x never did.
  </p>
  <Snippet code={weights} lang="ts" />

  <h2>Unloading sounds <Since v="1.11" /></h2>
  <p>
    In v2, <code>engine.unload(name)</code> <Since v="2.0" /> does this for
    any kind (sound, sprite, variants, music, stream); see
    <a href="/concepts/engine/">Engine</a>.
  </p>
  <p>
    <code>removeSound(name)</code> drops the registry entry. The buffer
    stays in the internal LRU cache so a re-load is free. Use
    <code>unloadSound(name)</code>, which evicts by default,
    when the user is unlikely to revisit the asset. Hot-swapping themes is
    the canonical case.
  </p>
  <Snippet code={unload} lang="ts" />

  <h2>Loudness normalization on load</h2>
  <Snippet code={normalize} lang="ts" />

  <h2>Typed banks via <code>npx zvuk gen</code></h2>
  <p>
    Keep your sound names in a manifest, run the <a href="/reference/cli/">CLI</a>, get a typed loader back.
    <code>engine.sound("coin")</code> autocompletes against the literal union.
  </p>
  <Snippet code={banks} lang="ts" />

  <h2>Cache & memory <Since v="1.14" /></h2>
  <p>
    Decoded buffers are cached by URL inside the engine. Loading the same URL
    twice is free, and two loads of it in flight at once share one fetch and
    one decode. The cache is an LRU budgeted in bytes and in entries,
    64 MiB and 128 by default, set with
    <code>createEngine({'{'} cache: {'{'} maxBytes, maxEntries {'}'} {'}'})</code>.
    See <a href="/concepts/engine/">Engine</a> for the arithmetic.
  </p>

  <h2>Pitfalls</h2>
  <div class="pitfall">
    <div class="pitfall-title">Don't load before unlock.</div>
    The decoder needs a live AudioContext. <code>loadSound</code> calls
    <code>touch()</code> to construct the context lazily, but on iOS Safari
    <code>decodeAudioData</code> can hang on a suspended context. Always
    <code>await unlock()</code> first, ideally on the same gesture that
    triggers the load.
  </div>
</Docs>
