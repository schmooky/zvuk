---
import MixerDashboard from '../../components/demos/MixerDashboard.tsx';
import { SITE } from '../../lib/seo';
import '../../styles/global.css';
const title = `Mixer Dashboard · ${SITE.name}`;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="zvuk mixer dashboard — popped out for second-monitor mixing." />
    <meta name="robots" content="noindex" />
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light') document.documentElement.classList.remove('dark');
          else document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-border/60">
      <div class="mx-auto max-w-3xl flex items-center justify-between px-5 py-3">
        <div class="flex items-center font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">
          {SITE.name} · mixer dashboard
        </div>
        <a
          href="/concepts/engine/"
          target="_top"
          class="text-[11px] font-mono uppercase tracking-[0.14em] text-muted-foreground hover:text-foreground"
        >
          docs ↗
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-5 py-6">
      <MixerDashboard client:load standalone />
      <p class="mt-4 text-xs text-muted-foreground">
        This is a standalone window. The audio context is local to this tab —
        independent from the embedded version on the docs page.
      </p>
    </main>
  </body>
</html>
