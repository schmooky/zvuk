---
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import { ogSlug } from '../lib/og-manifest';
import { type FaqEntry, SITE } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Override the OG image slug. Defaults to a guess based on URL path. */
  og?: string;
  /** Question/answer pairs to publish as FAQPage structured data. */
  faq?: FaqEntry[];
  /** ISO date this page's content last changed. */
  modified?: string;
  /** `article` for documentation pages, `website` for the landing and indexes. */
  type?: 'website' | 'article';
  /** Section name for `article:section`. */
  section?: string;
  /**
   * Mark <main> as the Pagefind body. The docs layout turns this off and
   * marks its <article> instead, so the sidebar is never indexed.
   */
  searchBody?: boolean;
  noindex?: boolean;
}
const {
  title = `${SITE.name}: ${SITE.tagline}`,
  description = SITE.description,
  og,
  faq,
  modified,
  type = 'website',
  section,
  searchBody = true,
  noindex = false,
} = Astro.props as Props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
// Slugs are the full route path, so /api/Voice/ and /concepts/voice/ get
// their own cards instead of colliding on a lowercased last segment.
const slug = og ?? ogSlug(Astro.url.pathname);
const ogImage = new URL(`/og/${slug}.png`, SITE.url).toString();
const markdownHref = new URL(
  Astro.url.pathname === '/' ? '/index.md' : `${Astro.url.pathname.replace(/\/$/, '')}.md`,
  SITE.url,
).toString();
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* No-FOUC theme bootstrap, as on the sibling sites: the saved choice,
        else the OS preference, applied before first paint. */}
    <script is:inline>
      (() => {
        let dark = true;
        try {
          const t = localStorage.getItem('theme');
          dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch (_) {}
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <title>{title}</title>
    {/* A Markdown copy of this page, for anything that would otherwise strip
        the HTML to read it. /llms.txt indexes the site; /llms-full.txt is the
        whole corpus in one file. */}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownHref} title="This page as Markdown" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* The primary violet in each scheme: oklch(0.54 0.21 286) light,
        oklch(0.66 0.19 285) dark (global.css --primary). */}
    <meta name="theme-color" content="#6b4ee0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#8a7bff" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      pathname={Astro.url.pathname}
      image={ogImage}
      faq={faq}
      modified={modified}
      type={type}
      section={section}
      noindex={noindex}
    />
    {/* Both faces are used above the fold; preloading beats waiting for the
        CSS to be parsed before the font request even starts. */}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <Nav />
    {searchBody ? (
      <main id="content" data-pagefind-body><slot /></main>
    ) : (
      <main id="content"><slot /></main>
    )}
    <Footer />
  </body>
</html>
