{
  "name": "zvuk-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/build-og-assets.mjs && node scripts/build-api.mjs && node scripts/build-changelog.mjs && node scripts/build-llms.mjs",
    "prebuild": "node scripts/build-og-assets.mjs && node scripts/build-api.mjs && node scripts/build-changelog.mjs && node scripts/build-llms.mjs",
    "build": "astro build && pagefind --site dist",
    "postbuild": "node scripts/copy-pagefind.mjs && node scripts/check-og.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "api:gen": "node scripts/build-api.mjs",
    "changelog:gen": "node scripts/build-changelog.mjs",
    "llms:gen": "node scripts/build-llms.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@schmooky/zvuk": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^5.13.0",
    "astro-og-canvas": "^0.7.0",
    "canvaskit-wasm": "^0.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "pagefind": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.27.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "marked": "^18.0.3",
    "typescript": "^5.9.0"
  }
